#;------------------------
[Statedef 190195; type:S; movetype:I; physics:S; anim:47; sprpriority:-2; velset:0,0; ctrl:0;]
if !time && ( (animtime>0) || (animtime<-5) ) { changeanim{value:40} }
if !time { posset{y:0} }

#;sys::partner_goto-assist2
#;if (animtime=0) && roundstate=2 && sysfvar(4)>0 {
	#;let va = 1000;
	#;if map(a4b_assist1)>159 && selfstatenoexist(map(a4b_assist1)) { let va = map(a4b_assist1); }
	#;changestate{ value:$va; ctrl:0 }
#;}

if (animtime=0) && roundstate=2 && sysfvar(4)>0 && sysfvar(0)>0 && playeridexist(floor(sysfvar(0))) && playerid(floor(sysfvar(0))),var(0)=90900 {
changestate{ value:playerid(floor(sysfvar(0))),var(53+id-playerid(floor(sysfvar(0))),sysvar(0)); ctrl:0 }
}


#;sys::partner_ex-change_safety
if (animtime=0) { changestate{ value:0; ctrl:1 } }

#hyper-cancel _
if  power >= 500 && playerid(sysvar(0)),teamside=teamside &&
!time && sysfvar(4)=0 && sysvar(0)>0 && playeridexist(sysvar(0)) {
	if playerid(sysvar(0)),sysfvar(4)=3 {changestate{ value:Const(StateTagSuperAssist); ctrl:0;}}
}

