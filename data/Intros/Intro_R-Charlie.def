;===================================================================
; THE STORY TEXT IS NOT IN THIS FILE.
;
;   The words live in   data/Intros/intro_texts.lua
;   under the key       ['<this file's name without .def>']
;
; This .def only describes WHERE the text goes - the box, the font,
; the typing speed. See the STORY TEXT block further down for those.
; external/mods/sfaz_intro_text.lua puts the two together when the
; storyboard loads.
;
; That split is deliberate: the layout differs per character because
; the art does, but the writing is all in one file so it can be
; edited in one place.
;===================================================================

[Info]
localcoord = 384,224

[SceneDef]
spr = Intro_New.sff
startscene = 0       ;Escena en la que debe partir (default)
key.skip   = a, b, c, x, y, z
key.cancel = s, m

[Scene 0]
; Fade
fadein.time = ;30       ;Time to take for fading in
fadein.col = 255,255,255     ;Use 255,255,255 for white-fade
;fadeout.time = 30
;fadeout.col = 255,255,255
; Screen color
clearcolor = 0,0,0
layerall.pos = 192,0


;------------------------------------


layer0.anim = 0        ; FX Fondo
layer1.anim = 1        ; FX suelo
layer2.anim = 2        ; Character (Port)
layer3.anim = 3        ; Character (Anim)
layer6.anim = 4        ; Barra Sup
layer7.anim = 5        ; Character (His Stage)
layer8.anim = 6        ; Barra Inf 1
layer9.anim = 7        ; Barra Inf 2
;layer8.anim = 8        ; TXT  -- replaced by the story text
;                             layers below. Uncomment to get
;                             the old sprite text back.
layer10.anim = 9        ; Name Chara y otros
layer4.anim = 10        ; bg
layer5.anim = 11        ; Select screen fade

p1.anim      = 0        ; action number in the character's .air
p1.pos       = -140,195 ;-60, -20    ; same space as layerall.pos
p1.scale     = 1.0, 1.0
p1.facing    = 1
p1.starttime = 0           ; ticks after the SCENE starts
p1.endtime   = -1          ; -1 = until the scene ends
p1.loop      = 1
p1.applypal  = 1  
;p1.layerno = 2      ; which pass, exactly like any layer
p1.order   = 6      ; draw immediately BEFORE layer6 (Barra Sup).
;                    ABOVE the two transition covers - layer4 "bg" and layer5
;                    "Select screen fade", which blank themselves out after 18
;                    and 12 ticks - so the character is on screen from frame 0
;                    and carries straight on from the select screen. BELOW the
;                    bars and name plate the story text sits on.
;                    Those two covers used to be layer10/layer11, i.e. on top of
;                    everything, and that is what hid the character for the first
;                    ~18 ticks. Layer numbers only set draw order - every anim
;                    number they point at is unchanged.
                    ; omitted = in front of everything (current behaviour)
                    ; 0 = behind everything


;-------------------------------------------------------------------
; STORY TEXT - real font text, typed out letter by letter.
;
; These layers are deliberately EMPTY here. The words come from
; data/Intros/intro_texts.lua and are injected by
; external/mods/sfaz_intro_text.lua; starttime/endtime are assigned
; there too, so chunk lengths never have to be timed by hand.
;
; A layer only becomes a text layer if it declares "font", which is
; why these are declared at all rather than created from script: the
; text sprites are built when the .def loads. Layers with no text are
; skipped entirely, so reserving eight slots costs nothing.
;
; There is deliberately no  layerNN.text = ""  line: an empty pair of
; quotes is stored as the two-character string, not as an empty
; string, so every slot would draw a literal "".
;
;-------------------------------------------------------------------
; WHICH VALUES TO TUNE
;
; localcoord MUST BE PRESENT and match [Info] localcoord above. It is
;   not inherited. Without it the layer gets 0,0, SetLocalcoord()
;   bails out, localScale stays 0, and the wrap width collapses to a
;   line break after every word.
;
; THE FONT MATTERS. A space is measured as the font's Size[0]
;   (src/font.go CharWidth) unless the font ships a real space glyph.
;   A font whose header records the SHEET size rather than a character
;   cell - sfa2_dialogue.fnt is "Size = 621,17" - therefore measures
;   every space as 621 units and breaks after every word. That font
;   works here because it does have a space glyph and the engine now
;   prefers it; a font with neither will not.
;
; *** offset.x AND THE FONT'S ALIGNMENT ARE ONE SETTING. ***
;
; The wrap width is NOT the window width. src/font.go getLineLength()
; derives it from the alignment AND from where the text sits:
;
;   align 1  (left)    width = RIGHT - x      x must be the window's LEFT
;   align 0  (centre)  width = min(x - LEFT, RIGHT - x) * 2
;                                             x must be the window's CENTRE
;   align -1 (right)   width = x - LEFT       x must be the window's RIGHT
;
; where  x = layerall.pos.x + offset.x  (layerall.pos.x is 192 here).
;
; Change one, recompute the other, or the width silently collapses.
;
; textwindow = LEFT, TOP, RIGHT, BOTTOM, in 320-WIDE space - not this
; .def's 384 localcoord. src/font.go drawWindow() multiplies by
; localScale and re-centres, so the usable range is roughly 0..320.
;
; All eight layers must match - they are one box.
;-------------------------------------------------------------------
layer20.font        = sfa2_dialogue.fnt, 0, 1, 255, 255, 255, 255
layer20.localcoord  = 384, 224
layer20.offset      = -108, 190
layer20.textwindow  = 24, 150, 346, 220
layer20.textwrap    = w
layer20.textdelay   = 2
layer20.textspacing = 0, -1
layer20.layerno     = 2

layer21.font        = sfa2_dialogue.fnt, 0, 1, 255, 255, 255, 255
layer21.localcoord  = 384, 224
