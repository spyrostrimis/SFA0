;-------------------------------------------------------------------
[Hiscore Info] ;Ikemen feature
; MIGRATION: item.data.* renamed to item.result.* by the engine, and
; rank/score/win values are now formatted as numbers (%d) not strings.

; ranking.<gamemode> = score | time | win
; system.base.def only ships defaults for the modes the engine knows about
; (arcade, teamarcade, teamcoop, netplayteamcoop, timeattack, survival,
; survivalcoop, netplaysurvivalcoop), so SFAZ's own modes must declare theirs.
; This value does more than pick a hiscore column - MotifWin.initResultsVariant
; (src/motif.go) switches on it, and with no entry it takes the "no formatting
; fallback" branch and draws winstext.text VERBATIM, which is why
; "WINS: %i" appeared with a literal %i. It also gates rankingWouldPlace(),
; so without it the mode records no hiscore and the results screen never uses
; its p<n>.win.state anims.
; "win" passes (wins, losses) to the text: first %i = wins, second = losses.
ranking.vs100kumite = win

enabled = 1
time = 1000
fadein.time = 50
fadein.col = 0, 0, 0
;fadein.anim =
fadeout.time = 50
fadeout.col = 0, 0, 0
;fadeout.anim =

pos = 0, -1
title.offset = 20, 32
title.font = 5,1,1; 191,191,191
title.scale = 1.0, 1.0
;title.text = "Ranking %s"
title.uppercase = 0
title.layerno = 2

; Per-mode hiscore titles. NOTE the key shape: title.<gamemode>.text
; (not title.text.<gamemode>). The engine defaults only cover the stock modes
; -- arcade, teamarcade, teamcoop, timeattack, survival, survivalcoop -- so
; SFAZ's custom modes had no title and fell back to the generic
; "title.text = Ranking %s".
title.worldtour.text = Ranking World Tour
title.vs100kumite.text = Ranking VS100 Kumite
title.bossrush.text = Ranking Boss Rush

