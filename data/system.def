; No trailing "-1,0, 0,0, -1" here on purpose. That element is a BLANK held
; forever, and a -1 time ENDS an animation - so it defeated the Loopstart above
; and the marker showed for its 24 ticks and then vanished for good. Without it
; the action loops from Loopstart and the pin keeps pulsing.


[SFAZ Select Outro]
enabled = 1
time = 16
face2.dist  = 220 ; Pixels each portrait travels. P1 goes -x, P2 goes +x.
face2.disty = 0
title.dist  = 60 ; Pixels the game mode title travels UP.
curve       = 2 ; 1 = linear, 2 = accelerating out, 3 = more so.
names       = 1
bg.hide     = 88888888
bg.play     = 88888887
bg.playreset = 0
bg.playtime = 0 ; Ticks bg.play needs before its last frame is reached. 
cursors     = 1
; The roster cell portraits (9000,0 - what alternate characters use to change
; their cell image) stop being drawn the same frame bg.play does, so they do
; not float on after the plate behind them has gone. 0 leaves them up.
cells       = 1
world.elem  = -2
world.dist  = 60
world.hide  = 1 ; The world layer (sprite 100,1) slides up too, then hides. Addressed by
bg.playhide = 1 ;play the frame fadeout.anim starts DRAWING
bg.playhidemax = 180


[SFAZ Victory Stage]	; set from Lua (external/mods/sfaz_victorystage.lua)
enabled = 1
; 5800,0 for now. Swap to `anim = 58000` once that action exists - anim wins
; when both are set, and it falls back to spr if the action is missing.
spr     = 5800,0
;anim   = 58000
offset  = 0, 0
scale   = 1, 1
facing  = 1
layerno = 2 ; MUST be 0, 1 or 2
; The emblem shows the NEXT match's stage, read out of the roster that
; select.def's order / ordersurvival already build. Script-driven paths
; (kumitepath.lua, the per-character arcadepath files) choose each opponent
; inside a launchFight call that has not happened yet, so there is nothing to
; read and the emblem stays blank there.
; fallback = 1 shows the stage just fought instead of a blank.
fallback = 0
; Entry slide, EARLY (pre-match) victory screen ONLY - the post-match one never
; slides, the emblem is just part of the screen you have arrived at.
; `from` is where it starts RELATIVE to its resting place, so 0,-120 drops it
; in from above. It travels to 0,0 over `time` ticks.
; curve: 1 = linear, 2 = eases out (quick, then settles), higher = sharper.
; time = 0 turns the slide off.
early.slide.from  = 0, -120
early.slide.time  = 20
early.slide.curve = 2
; The location marker: the animated "you are here" pin on the map. This is a
; MOTIF animation (it lives in this file's sff), unlike the map itself which
; comes from the stage. Only its POSITION is per stage, and that is read from
; data/stage_marks.lua - one {x,y} per stage def, taken from a single 224,0,0
; pixel painted on that stage's own 5800,0. See the header of that file.
; A stage with no entry there simply gets no marker; the map still shows.
; Positioning is handled for you: x,y are in the MAP SPRITE's pixels (5800,0 is
; 384x224, axis top-left), and the emblem's own offset/scale are applied on top,
; so the pin stays put wherever the map is drawn - including mid-slide on the
; early victory screen.
mark.anim    = 5801
mark.offset  = 0, 0     ; nudge applied to EVERY stage's marker
mark.scale   = 1, 1
mark.layerno = 2        ; same pass as the map; drawn immediately after it

[SFAZ Defeated Portraits]
enabled  = 1
spr      = 9000,9000
pos      = 67, 179 ; in motif localcoord (384 x 224).
spacing  = 26.95, 0
; Offset WITHIN a slot for members 2, 3, ... of a simul/turns match. One match
; is always ONE slot wide whatever this is set to, so the row stays lined up
; with the pedestals behind it. 0,0 stacks them exactly on top of each other;
; a small value lets the one behind peek out. Keep it well under `spacing` or
; the extra member spills onto the next pedestal.
groupspacing = 10, 0
scale    = 1, 1
facing   = 1
layerno  = 2 ; MUST be 0, 1 or 2
max      = 10
window   = -1, -1, 384, 224
applypal = 0

;"Next opponent" marker
next.anim   = 748
next.offset = -4, 0
next.scale  = 1, 1

