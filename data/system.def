; MIGRATION: the speaker NAME is deliberately not shown here, but leaving the
; keys commented does NOT disable it -- src/resources/defaultMotif.ini fills in
; every key this file omits, and its dialogue defaults are
;     p1.name.font = f-6x9.def, 0, 1, 255,255,255,255, -1
;     p1.name.offset = 0, 0
; so the display name was drawn in white at the top-left corner of the screen,
; appearing and vanishing with the portraits. Font index -1 is not in the
; motif's font map, so TextSprite.draw returns before drawing anything.
p1.name.font = -1, 0, 1, 255, 255, 255, 255, -1
