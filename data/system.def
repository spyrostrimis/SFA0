;-----------------------
;Continue screen background
[Continuebgdef]
spr = ""
; -1 DISABLES the background clear rect. MotifContinue.draw() does:
;     if m.ContinueBgDef.BgClearColor[0] >= 0 { RectData.Draw(layerno) }
; and although the Go struct defaults this to -1, defaultMotif.ini overrides it
; to 0,0,0 -- so with nothing set here the continue screen painted a full black
; rect over the paused fight scene, hiding the stage and the defeated player.
bgclearcolor = -1, 0, 0


;-------------------------------------------------------------------
[Game Over Screen]
enabled = 1
storyboard = Storyboards/Over.def

[Pause Menu]

	fadein.time = 0
	fadein.col = 0, 0, 0
	fadein.anim = -1
	fadeout.time = 0
	fadeout.col = 0, 0, 0
