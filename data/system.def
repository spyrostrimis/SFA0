; applypal / anim belong to the slot that actually RENDERS. p1.applypal and
; p1.anim configure the MAIN face slot, but the portrait shown here is face2,
; which has its own ApplyPal/Anim in the engine (motif.go: dst.ApplyPal vs
; dst.Face2.ApplyPal) -- so they must be set on face2 to have any effect.
p1.face2.applypal = 1
; p1.face2.anim = 181 -- disabled: still yields neither anim nor portrait even
; with preloadListChar(181) registered. Setting anim takes the "animNo >= 0"
; branch in buildPortrait (motif.go), which skips the sprite branch entirely, so
; a failed anim lookup loses the portrait too. Needs diagnosis before re-enabling
; (buildPortrait has commented-out debug prints for exactly this).
; NOTE: duplicate keys resolve FIRST-INSTANCE-WINS, so the offset/window
; lines below were already being ignored; commented out to make the active
; values unambiguous.
;p1.face2.offset = -369.7,12
p1.face2.scale = 1,1
p1.face2.facing = 1
;p1.face2.window = -1, 0, 384, 224

