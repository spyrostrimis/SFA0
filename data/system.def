;----------------------------
[Info]
name = "Street Fighter Alpha Zero"
author = "AgentEd"
versiondate = 09,01,2009
mugenversion = 1.0
localcoord = 384,224

;----------------------------

[Files]
spr = system.sff
snd = system.snd
select = select.def
fight = fight.def
font1 = Matchno.fnt;f-4x6.def	; For Debug
font2 = sfa2_dialogue.fnt	; dialogue
font3 = sfz2a_font.fnt 	; Small
font4 = sfz2a_system.fnt ; Medium
font5 = sfzbigname.fnt	; sfz1
font6 = Name2.fnt	; sfz2
font7 = Name.fnt	; sf2
glyphs = data/glyphs.sff

;Attract mode definition
[Attract Mode] ;Ikemen feature
enabled = 1
fadein.time = -1
fadein.col = 0, 0, 0
fadeout.time = 10
fadeout.col = 0, 0, 0

credits.keycode = F9
options.keycode = F11

credits.snd = 100, 5
logo.storyboard = Storyboards/Logo.def
intro.storyboard = Storyboards/SFAZ_Intro.def
start.storyboard = Storyboards/Start.def
start.time = 1
;start.insert.text = "Insert coin"
start.insert.offset = 159, 185
start.insert.font = -1,0,0
start.insert.scale = 1.0, 1.0
start.insert.blinktime = 30
start.press.text = "
start.press.offset = 159, 185
start.press.font = -1,0,0
start.press.scale = 1.0, 1.0
start.press.blinktime = 30
; MIGRATION: the credit-insert COUNTDOWN, not a general timer. main.f_attractStart
; sets timerActive whenever the credit count changes, so pressing the credits key
; flashed it for a frame in the bottom-right corner -- clipped, because y = 234 is
; past the bottom of this file's 384 x 224 localcoord (it fitted a 240-tall one).
; count/framespercount/displaytime are all 1, so it never had anything to show.
; Hidden with font -1 rather than count = -1 on purpose: count = -1 skips
; f_drawTimer entirely, which is what clears timerActive, and a timerActive that
; never clears blocks the screen's own (not timerActive and counter >= start.time)
; auto-advance. Font -1 is not in the motif's font map, so TextSprite.draw returns
; without drawing while the countdown still runs and expires exactly as before.
start.timer.offset = 310, 234
start.timer.font = -1,0,-1
start.timer.scale = 1.0, 1.0
start.timer.text = "%i"
start.timer.count = 1
start.timer.framespercount = 1
start.timer.displaytime = 1
start.done.snd = 100, 1

;title.offset = 5, 30;220
;title.font = 5, 0, 1
;title.scale = 1.0, 1.0
;title.text = "MAIN MENU"

credits.text = "CREDITS %2i"
credits.offset = 5, 10;30
credits.font = 3,1,1
credits.scale = 1.0, 1.0

fadeout.anim = 2009
menu.pos = 285, 70 ;276,35
menu.item.font = 4,2,1
menu.item.active.font = 4,0,1
menu.item.spacing = 0, 18
menu.item.offset = 0, 1
menu.item.active.offset = 0, -1

menu.window.margins.y = 12, 8
menu.window.visibleitems = 11
menu.boxcursor.visible = 0
menu.boxcursor.coords = -48,-14,48,3
cursor.move.snd = 100,0	
cursor.done.snd = 100,1
cancel.snd = 100,2

options.key = F11
menu.next.key = D
menu.previous.key = U
menu.accept.key = a, b, c, x, y, z
menu.done.key = a, b, c, x, y, z
menu.hiscore.key = B, F, s

; Removes the highlighted saved address in the JOIN GAME list. Only the
; serverjoin submenu listens for this key, and only "ip_*" rows can be deleted.
; The engine defaults this in [Title Info] only, so with attract mode enabled it
; has to be repeated here or saved addresses can never be removed in-game.
menu.item.delete.keycode = DELETE

; Submenu: Arcade
menu.itemname.menuarcade = "ARCADE    >"
menu.itemname.menuarcade.arcade = "STORY MODE" 
menu.itemname.menuarcade.teamarcade = "TEAM ARCADE"
menu.itemname.menuarcade.teamcoop = "COOPERATIVE" 
menu.itemname.menuarcade.back = "      <BACK"

menu.itemname.menunet = "ONLINE    >"
; SFAZ: room-code play needs no IP, port forwarding or VPN - listed first
; because it is the path almost everyone should take. The two GAME entries
; below are the original direct-IP netplay, kept for LAN and for players whose
; network is too restrictive for hole punching.
menu.itemname.menunet.roomhost = "HOST ROOM"
menu.itemname.menunet.roomjoin = "JOIN ROOM"
menu.itemname.menunet.serverhost = "HOST GAME"
menu.itemname.menunet.serverjoin = "JOIN GAME"
menu.itemname.menunet.back = "      <BACK"

; JOIN GAME submenu. "joinadd" and the saved IP entries MUST live under
; "serverjoin" - the engine only appends the addresses stored in config
; (Netplay.IP) to the item list of a submenu named serverjoin, and selecting a
; submenu with no items just backs out to the previous menu.
menu.itemname.menunet.serverjoin.joinadd = "NEW ADDRESS"
menu.itemname.menunet.serverjoin.back = "      <BACK"

; Menu shown to both sides once the netplay connection is established. The
; "server" group is never displayed in the title menu, it is opened by the
; engine after host/join synchronize.
