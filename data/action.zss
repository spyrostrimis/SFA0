#===============================================================================
# Global states (not halted by Pause/SuperPause, no helper limitations)
#===============================================================================
[StateDef -4]

ignoreHitPause if !const(Default.Enable.Action) || isHelper || teamSide = 0 || gameMode = "versus" || gameMode = "demo" || gameMode = "freebattle" || gameMode = "watch" || gameMode = "vs100kumite" || gameMode = "training" || gameMode = "timeattack" { #EDIT: no lifebar action messages in these modes
	# Do nothing, global code disabled locally or executed by helper or stage
} else if roundState >= 2 {
	# First Attack
	let ret = call IkSys_FirstAttack();
	if $ret {
		lifebarAction{spr: const(MsgFirstAttack), 0; top: 1}
	}
	# Counter Hit
	let ret = call IkSys_CounterHit();
	if $ret {
		lifebarAction{spr: const(MsgCounterHit), 0; top: 1}
	}
	# Technical
	let ret = call IkSys_Technical();
	if $ret {
		lifebarAction{spr: const(MsgTechnical), 0; top: 1}
	}
	# Reversal
	let ret = call IkSys_Reversal();
	if $ret {
		lifebarAction{spr: const(MsgReversal), 0; top: 1}
	}
	# Zero Counter - NOT handled here (SFAZ)
	#
	# The characters already do it themselves. 44 of the 46 have this in their
	# own [Statedef 2600]:
	#
	#     type = LifebarAction
	#     trigger1 = GameMode = "Arcade" || "Survival" || "Teamcoop" || "Worldtour"
	#     trigger1 = Movehit && Teamside = 1
	#     spr = 424,0
	#
	# which is already "player side, on hit, arcade" - so anything added here is
	# a SECOND message for the same action. To restyle the Zero Counter message,
	# change what sprite 424,0 looks like in fight.sff; to change when it fires,
	# it is a per-character edit in their 2600.
	#
	# (This is also why the stock Just Defend message was removed above:
	# MsgJustDefend = 424 in common.const, so it drew 424,0 - the characters'
	# Zero Counter graphic - on any tight block.)
	# Parry
	let ret = call IkSys_Parry();
	if $ret {
		lifebarAction{spr: const(MsgParry), 0; top: 1; redirectId: enemy,id}
	}
	# Just Defend - REMOVED (SFAZ)
	#
	# Sprite 424,0 (MsgJustDefend). Just Defend is not a mechanic in this game;
	# the message came from the stock Ikemen action set and fired on any tight
	# block - IkSys_JustDefend wants a guard-hit state within 3 ticks of holding
	# back. Since a Zero Counter is performed out of a block, it fired a few
	# ticks before the Zero Counter message for the same action, showing two
	# messages for one move.
	#
	# Removing the call is the whole fix. IkSys_JustDefend remains defined in
	# data/functions.zss, so restoring this is a matter of putting the two lines
	# back:
	#     let ret = call IkSys_JustDefend();
	#     if $ret { lifebarAction{spr: const(MsgJustDefend), 0; top: 1} }
	# Danger
	let ret = call IkSys_Danger();
	if $ret {
		lifebarAction{spr: const(MsgDanger), 0; timeMul: 2; top: 1}
	}
	# Dizzy
	let ret = call IkSys_Dizzy();
	if $ret {
		lifebarAction{spr: const(MsgDizzy), 0; timeMul: 2; top: 1}
	}
	# Guard Break
	let ret = call IkSys_GuardBreak();
	if $ret {
		lifebarAction{spr: const(MsgGuardBreak), 0; timeMul: 2; top: 1}
	}
	# Partner Down
	let ret = call IkSys_PartnerDown();
	if $ret {
		lifebarAction{spr: const(MsgPartnerDown), 0; timeMul: 2; top: 1}
	}
	# code executed only by P1 and P2
	if playerNo = teamSide {
		# Combo Count
		let ret = call IkSys_ComboCount();
		if $ret {
			# gdlk combo (mugen)
			if $ret >= 25 {
				lifebarAction{spr: const(MsgCombo25), 0; top: 1}
			# amazing combo (marvelous)
			} else if $ret >= 20 {
				lifebarAction{spr: const(MsgCombo20), 0; top: 1}
			# great combo (fantastic)
			} else if $ret >= 15 {
				lifebarAction{spr: const(MsgCombo15), 0; top: 1}
			# sweet combo (beautiful)
			} else if $ret >= 10 {
				lifebarAction{spr: const(MsgCombo10), 0; top: 1}
			# good combo (great)
			} else if $ret >= 5 {
				lifebarAction{spr: const(MsgCombo5), 0; top: 1}
			# nice combo (good)
			} else if $ret >= 3 {
				lifebarAction{spr: const(MsgCombo3), 0; top: 1}
			}
		}
		# Win Clutch
		let ret = call IkSys_WinClutch();
		if $ret {
			lifebarAction{spr: const(MsgWinClutch), 0; timeMul: 3; top: 1}
		}
		# Win Perfect
		let ret = call IkSys_WinPerfect();
		if $ret {
			lifebarAction{spr: const(MsgWinPerfect), 0; timeMul: 3; top: 1}
		}
		# Win Hyper
		let ret = call IkSys_WinHyper();
		if $ret {
			lifebarAction{spr: const(MsgWinHyper), 0; timeMul: 3; top: 1}
		}
		# Win Special
		let ret = call IkSys_WinSpecial();
		if $ret {
			lifebarAction{spr: const(MsgWinSpecial), 0; timeMul: 3; top: 1}
		}
	}
}
