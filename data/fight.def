p2.s.anim = 101
; Super Combo Finish
p1.h.anim = 102
p2.h.anim = 102

p1.h1.anim = 1021
p2.h1.anim = 1021
p1.h2.anim = 1022
p2.h2.anim = 1022
p1.h3.anim = 1023
p2.h3.anim = 1023
; Zero Counter. Detected by STATE (2600) in data/hyperlevel.zss, not by the hit
; attribute - a Zero Counter hits as "S, SA" like any other special - and not by
; reversal-ness, since some characters have reversals that are not Zero
; Counters. Uses [Begin Action 1024] further down.
; If this slot is left undefined it falls back to the SPECIAL icon, since that
; is what a Zero Counter is.
p1.zc.anim = 1024
p2.zc.anim = 1024

; CUSTOM COMBO (V-ISM). Set directly by the mode, not by the power-spend
; detector: data/custom_combo.zss keeps _sfaz_cc_active non-zero for the whole
; mode, and src/char.go (sfazIsCustomCombo) checks it BEFORE the hit-attribute
; branches - a custom combo can finish with any normal or special, so the
; attribute cannot identify it.
; The sprite lives in system.sff rather than fight.sff; readSfazHyperIcon()
; resolves that automatically.
p1.vism.anim = 1025
p2.vism.anim = 1025
; Grab
p1.throw.anim = 103
p2.throw.anim = 103
; Cheap
p1.c.anim = 104
p2.c.anim = 104
; Time Over
p1.t.anim = 105
p2.t.anim = 105
; Cheat
p1.suicide.spr = 101,0
p2.suicide.spr = 101,0
; Team Work (Simul Only)
p1.teammate.spr = 107,0
p2.teammate.spr = 107,0
; PERFECT!
p1.perfect.spr = 110,0
p2.perfect.spr = 110,0
; Use icons up until this number of wins
p1.shun.anim = 1026
p2.shun.anim = 1026
