; MIGRATION: 'max' (maximum simultaneous messages) is required by this
; engine. Without it only one message is retained, so each new warning
; replaced the previous one instead of stacking beneath it -- and the
; show/hide slide never got to play out (it read as a blink).
team1.max = 8
team1.spacing = 0,25      ;Spacing (was 0,3: this engine does not add the message height)
team1.start.x = -40       ;Starting x-coords (slide origin - NOT part of the +42 HUD shift)
team1.bg.layerno = 2
team1.bg.offset = 25,0
team1.bg.anim = -1
team1.bg.scale = 1,1
team1.bg.spr = 
team1.front.layerno = 2
team1.front.offset = 25,0.3
team1.front.scale = 1,1
team1.text.layerno = 2
team1.text.font = 1,0,1
team1.text.offset = 3,0   ;Offset of text
team1.text.scale = 1,1
team1.displaytime = 60    ;Time to show message
team1.showspeed = 2       ;Message showing up speed (1 = instant)
team1.hidespeed = 8       ;Message hiding speed (the larger value, the faster speed)

team2.pos = 42,0 
team2.max = 8
team2.front.scale = 0,0

; Ikemen feature
[Ratio]
; SFAZ: drawn by the ENGINE now (FightScreenRatio), not by
; external/mods/sfaz_ratio_lifebar.lua - that mod is disabled and kept only as a
; reference. The keys below are unchanged; what changed is that this is now an
; ordinary lifebar element, so it draws in the lifebar's own pass (behind the
; characters, in layer order with its neighbours), hides with the bars, and lands
; on the same pixel grid instead of leaving seams against them.
;
; The level is read off each side's point character as the "ratiolevel" map value,
; so nothing draws outside a ratio match and no enabled.<mode> lines are needed.
; Add pN.enabled.<mode> = 0 if you ever want it suppressed in one mode.
;
; Every layout key ReadAnimLayout understands now works, per level:
;   p1.level1.layerno = 0     ; 0/1/2 ONLY - anything else is silently not drawn
;   p1.level1.scale   = 1, 1
;   p1.level1.offset  = 0, 0
; and pN.bg.* / pN.top.* draw under and over the icon.
p1.pos          = 6, 28
p1.level1.spr   = 300, 0
p1.level2.spr   = 300, 1
p1.level3.spr   = 300, 2
p1.level4.spr   = 300, 3
p2.pos          = 375, 28
p2.level1.spr   = 300, 0
p2.level2.spr   = 300, 1
p2.level3.spr   = 300, 2
p2.level4.spr   = 300, 3