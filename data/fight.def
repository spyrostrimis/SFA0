[Mission]
; SFAZ: free-text note on the lifebar saying what the current match asks for.
; Styled and positioned on [AILevel] below (p2.pos = 227,21, font 8 bank 1), one
; row under it. Unlike every other section here it has no engine value to read:
; the string comes from Lua via setMissionText(), so the whole element - text,
; bg and top - stays hidden while that string is empty. It is drawn inside the
; same block as the lifebars, so it hides with them (dialogue, pause menu,
; nobardisplay) with nothing extra to configure.
pos = 227,21
; %s is where the note lands. Substituted BEFORE the note is split into lines,
; so a prefix here is printed once and not on every line.
text.text = %s
text.font = 8,1, 1
; Step between lines of a multi-line note (the note's own newlines).
spacing = 0, 9
;text.scale = 1, 1
;bg.spr =

; World Tour only for now. Add a line here to show notes in another mode; the
; mode still has to call setMissionText() for anything to appear.
enabled.worldtour = 1

[AILevel]

p2.pos = 227,21
;p2.bg.spr = 
p2.text.font = 8,1, 1
p2.text.text = CPU-%s

format.decimal.places = 0
format.decimal.separator = .

p1.enabled.watch = 1

p2.enabled.arcade = 1
p2.enabled.bossrush = 1
p2.enabled.freebattle = 1
p2.enabled.netplaysurvivalcoop = 1
p2.enabled.netplayteamcoop = 1
p2.enabled.scorechallenge = 1
p2.enabled.survival = 1
p2.enabled.survivalcoop = 1
p2.enabled.teamcoop = 1
p2.enabled.timeattack = 1
p2.enabled.timechallenge = 1
p2.enabled.training = 1
p2.enabled.vs100kumite = 1
p2.enabled.watch = 1
