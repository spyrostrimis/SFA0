;---------------------------------------------------------------------------
; Win screen animation
[Statedef 19000]
type = S
ctrl = 0
anim = 181
velset = 0,0

; Clear round-end FX carried over from the win pose (state 181).
; The per-character "Perfect msg" is an Explod with no removetime, so it
; survives the change into this state and re-appears on the Win Screen.
; Time = 0 runs BEFORE this state's own Explod (spawned at Time = 1), so the
; win FX below is not affected.
[State 19000, Clear win-pose FX]
type = RemoveExplod
trigger1 = Time = 0

[State 950, PosSet]
type = VelSet
trigger1 = 1
x = 0

[State 810, 5]
type = Explod
trigger1 = Time = 1
anim = F6050
id = 6020
postype = left
bindtime = -1
sprpriority = -3
scale = 1,1
ownpal = 1
removetime = 800
persistent = 0
ignorehitpause = 1

; noBG is not decoration - it is what makes the win-screen backdrop VISIBLE.
;
; The F6050 explod above is sprpriority = -3, so System.draw paints it in the
; layerNo == -1 sprite pass:
;
;     FillRect(scrrect, nobg ? black : stage.bgclearcolor)
;     if !nobg { stage.draw(-1) }
;     spriteList.draw(-1)            <- F6050 lands here
;     if !nobg { stage.draw(0) }     <- the stage paints straight over it
;
; Without noBG the stage's own layer 0 is drawn AFTER the backdrop and hides it
; completely, which reads in game as "the background disappears on the win
; screen". It looked intermittent because it was covered by accident: the
; roster's KO-finish blocks in [StateDef -2]/[StateDef -3] assert noBG while
; NumExplod(6020) = 1, and 6020 is the ID this state's explod uses - so the 33
; characters that carry that block masked the omission and the other 15
; (Sagat, Guile, Bison, Balrog, Charlie, Karin, both Codys...) did not.
;
; Asserted here, unconditionally, so the state is self-sufficient and does not
; depend on what any individual character happens to assert. Same reason the KO
; finish pairs noBG with noFG - see SFAZ_SESSION_HANDOVER.md section 4b.
[State 950, Nofg]
type = AssertSpecial
trigger1 = 1
flag = nobardisplay
flag2 = noFG
flag3 = noBG

; one player win
[State 950, PosSet]
type = PosSet
trigger1 = Time = 0
trigger1 = Numpartner = 0
x = 0

; two player win
[State 950, PosSet]
type = PosSet
trigger1 = Time = 0
trigger1 = Playerno != Teamleader
trigger1 = Numpartner = 1
x = -30

[State 950, PosSet]
type = PosSet
trigger1 = Time = 0
trigger1 = Playerno = Teamleader
trigger1 = Numpartner = 1
x = 30

;three player win
[State 950, PosSet]
type = PosSet
trigger1 = Time = 0
trigger1 = Playerno = Teamleader && Numpartner = 2
x = 0

[State 950, PosSet]
type = PosSet
trigger1 = Time = 0
trigger1 = Playerno 3
trigger1 = Numpartner = 2
x = -50

[State 950, PosSet]
type = PosSet
trigger1 = Time = 0
trigger1 = Playerno = 5
trigger1 = Numpartner = 2
x = 50

