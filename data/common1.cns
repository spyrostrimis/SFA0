;flag = NoMusic

[State -2, StopDialogueMusic]
type = StopSnd
trigger1 = !MotifState(dialogue)
channel = 200

; MIGRATION: HitScaleSet was removed from the engine (last seen in 2024 builds).
; Equivalent behavior via AttackMulSet: 0.795x damage while in these attack
; states on the P1 side, default multiplier otherwise.
[State -4, Difficulty]
type = AttackMulSet
trigger1 = stateno = 200 || stateno = 230 || stateno = 400 || stateno = 430
trigger1 = TeamSide = 1
value = 0.295

[State -4, Difficulty]
type = AttackMulSet
trigger1 = stateno = 210 || stateno = 240 || stateno = 410 || stateno = 440
trigger1 = TeamSide = 1
value = 0.595

; Scope note: the original HitScaleSet only ever applied to TeamSide 1, so the
; reset must be confined to TeamSide 1 too. Written as "|| TeamSide != 1" it was
; true on EVERY P2 frame, force-setting the opponent's attack multiplier to 1
; each tick -- which the 2024 build never did.
[State -4, DifficultyReset]
type = AttackMulSet
trigger1 = TeamSide = 1
trigger1 = !(stateno = 200 || stateno = 230 || stateno = 400 || stateno = 430 || stateno = 210 || stateno = 240 || stateno = 410 || stateno = 440)
value = 1

[State Test]
type = MatchRestart
trigger1 = Gamemode = "Timeattack"
trigger1 = WinKO && Teamside = 2 && Time = 200

[State 181, 16]; Remove defeated opponent from the ending sequence
type = AssertSpecial
trigger1 = p2stateno = 18800
trigger2 = p2stateno = 19000
flag = invisible

; Hide the stage WHILE AN ENDING TRANSITION IS BLACK - and only then.
;
; The ending explods do not cover the whole screen, so what shows around and
; through a half-faded F9999 blink is the live stage, with the KO'd opponent
; lying on it. Statedef 18800 cannot just assert noBG for its whole duration:
; several endings deliberately want the stage seen (that is why picture layers
; must not fade - see SFAZ_SESSION_HANDOVER.md section 4e).
;
; external/mods/sfaz_ending_text.lua sets sfaz_end_blink for the 21 ticks the
; blink is actually on screen and clears it after, so this is scoped to exactly
; those frames. Living HERE rather than in each character's 18800 is what lets
; it apply to all 45 converted endings without reconverting any of them.
;
; noBG makes System.draw fill black instead of drawing the stage; it does not
; touch explods, so the ending's own art is unaffected.
[State 181, 17]; Ending transition - hide the stage behind the blink
type = AssertSpecial
trigger1 = stateno = 18800 && Map(sfaz_end_blink) != 0
flag = noBG

