[Info]
name = "Boss Buddha" ;Statue of Buddha - Thailand
mugenversion = 1.0
author = "Ehnyd"

[Camera]
startx = 0
starty = 0
boundleft = -215
boundright = 215
boundhigh = -16
boundlow = 8
verticalfollow = .1
floortension = 0
tension = 60

[PlayerInfo]
p1startx = -75          ;Starting x coordinates
p1starty = 0            ;Starting y coordinates
p1startz = 0            ;Starting z coordinates
p1facing = 1            ;Direction player faces: 1=right, -1=left
p2startx = 75
p2starty = 0
p2startz = 0
p2facing = -1

leftbound  = -1000 ;Left bound (x-movement)
rightbound =  1000 ;Right bound
topbound  =  0     ;Top bound (z-movement)
botbound  =  0     ;Bottom bound

[Scaling]
topz     = 0       ;Top z-coordinate for scaling
botz     = 50      ;Bottom z-coordinate for scaling
topscale = 1       ;Scale to use at top
botscale = 1.2     ;Scale to use at bottom

[Bound]
screenleft = 24    ;Dist from left of screen that player can move to
screenright = 24   ;Right edge

[StageInfo]
zoffset = 200
autoturn = 1
resetBG = 0
localcoord = 384, 224
;xscale = 1
yscale = 1

[Shadow]
color = 16,16,16
yscale = .05

[Reflection]
intensity = 0

[Music]
bgmusic = sound/Sagat2.mp3
bgmloopstart=2241627
bgmloopend=4808826
bgvolume = 0
bgmusic.victory = Sound/Screenpack/Stage End.wav
bgmloopstart.victory = 359396
bgmloopend.victory = 362287

[BGdef]
spr = stages/BuddhaNight.sff
;debugbg = 1

[BG farback]
type  = normal
spriteno = 2,0
start = 0, -16
tile = 1,0
delta = .43,1
mask=1

[BG mid back]
type  = normal
spriteno = 1,5
start = 0, -16
delta = .50,1
mask=1

[BG mid back]
