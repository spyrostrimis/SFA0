;============================================================================
;- For non-commercial use only.
;- https://mugenroad.blogspot.com/
;- MUGEN 1.0/1.1 & IKEMEN GO, preferably for 4:3 resolutions.
;============================================================================
[Info]
name = "Mike Boss"
versiondate = 13,11,2023
mugenversion = 1.0
author = "Slayer"

;----------------------------------------------------------------------------
[CAMERA]
startx = 0
starty = 0
boundleft  =-160
boundright = 160
boundhigh  =-17
boundlow   = 0
verticalfollow = .3
floortension   = 72
tension        = 60
cuthigh        = 0
cutlow         = 0
overdrawhigh   = 28
overdrawlow    = 28

;----------------------------------------------------------------------------
[PLAYERINFO]     
;--- Player 1 ---
p1startx =-70    
p1starty = 0     
p1startz = 0     
p1facing = 1     

;--- Player 2 ---
p2startx = 70    
p2starty = 0     
p2startz = 0     
p2facing =-1     

;--- Common ---  
leftbound  =-1500
rightbound = 1500
topbound   = 0  
botbound   = 0  

;----------------------------------------------------------------------------
[SCALING]
topz     = 0  
botz     = 50 
topscale = 1  
botscale = 1.2

;----------------------------------------------------------------------------
[BOUND]
screenleft  = 22
screenright = 22

;----------------------------------------------------------------------------
[STAGEINFO]
localcoord = 384, 224
zoffset = 200
autoturn = 1
resetBG = 0
xscale = 1; .8333333
yscale = 1; 1.07142857
portraitscale = 2

;----------------------------------------------------------------------------
[SHADOW]
color = 67,50,0
yscale = .05
intensity = 2
fade.range =-150,0

;----------------------------------------------------------------------------
[REFLECTION]
intensity = 0

;----------------------------------------------------------------------------
[MUSIC]
bgmusic = sound/SFA-TrainGarage2.ogg	;SLUS-00197_13
bgmvolume = 100
bgmloopstart= 139749
bgmloopend  = 3009469
bgmusic.victory = Sound/Screenpack/Stage End.wav
bgmloopstart.victory = 359396
bgmloopend.victory = 362287

;------------------------------------------------------------------------------
[BGdef]
spr = Mike.sff
debugbg = 0

;----------------------------------------------------------------------------
;-IKEMEN GO ONLY, Select screen animation
[Begin Action 9000]
9000,1,0,0,-1
;------------------------------------------

[BG 0]
type = normal
spriteno = 0,0
start = 0,224
delta = .5,.5
mask = 1


[BG 0]
type = normal
spriteno = 0,1
start = 0,224
delta = .75,.8
mask = 1


[BG 1]
type = parallax
spriteno = 1,0
start = 0,224
delta = .8,.8
xscale = .8,.8
mask = 1

[BG 2]
type = normal
spriteno = 1,1
start = 0,224
delta = 1,1
mask = 1


[BG 3]
type = anim
actionno = 0
start = 0,224
delta = .8,.8
mask =1

[Begin action 0]
2,0,0,0,8
2,1,0,0,8
2,2,0,0,8
2,3,0,0,8


[BG 4]
type = anim
actionno = 1
start = 0,224
delta = .8,.8
mask = 1

[Begin action 1]
3,0,0,0,5
3,1,0,0,6
3,2,0,0,5
3,3,0,0,6


[BG 5]
type = anim
actionno = 2
start = 0,224
delta = .8,.8
mask =1

[Begin action 2]
4,0,0,0,7
4,1,0,0,8
4,2,0,0,7
4,3,0,0,8


[BG 6]
type = anim
actionno = 3
start = 0,224
delta = .8,.8
mask = 1

[Begin action 3]
5,0,0,0,6
5,1,0,0,7
5,2,0,0,6
5,3,0,0,7


[BG FRONT]
type = normal
spriteno = 1,2
start = 0,224
delta = 1.1,1.1
layerno = 1
mask = 1

