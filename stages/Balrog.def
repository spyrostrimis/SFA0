[Info]
name = "Fremont Street in Las Vegas - U.S.A."
mugenversion = 1.0
author = "Ehnyd"

[Camera]
startx = 0
starty = 0
boundleft = -190
boundright = 190
boundhigh = -16
boundlow = 8
verticalfollow = .1
floortension = 0
tension = 60

[PlayerInfo]
p1startx = -75
p1starty = 0
p1startz = 15
p1facing = 1

p2startx = 75
p2starty = 0
p2startz = 15
p2facing = -1

leftbound  = -1000
rightbound =  1000
topbound  =  0
botbound  =  0

[Scaling]
topz     = 0
botz     = 50
topscale = 1
botscale = 1.2

[Bound]
screenleft = 24
screenright = 24

[StageInfo]
zoffset = 200
autoturn = 1
resetBG = 0
localcoord = 384, 224
;xscale = 1
yscale = 1

[Shadow]
color = 16,16,16
yscale = .05
reflect = 1

[Reflection]
intensity = 35

[Music]
bgmusic = sound/Balrog.mp3
bgmloopstart = 463039
bgmloopend = 2782029
bgvolume = 255
bgmusic.victory = Sound/Screenpack/Stage End.wav
bgmloopstart.victory = 359396
bgmloopend.victory = 362287

[BGdef]
spr = stages/Balrog.sff
;debugbg = 0

