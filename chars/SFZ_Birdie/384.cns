; Win 1: lamiendo cadena (SFZ 2)
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[state 181, 1]
type = playsnd
trigger1 = animelem = 1
value = S0,17

[State 1100, 1]
type = RemoveExplod
trigger1 = time = 0
ID = 6000

[State 1100, 1]
type = RemoveExplod
trigger1 = time = 0
ID = 6010

[State 1100, 1]
type = RemoveExplod
trigger1 = time = 0
ID = 6020

[State 181, Win conditions]
type = AssertSpecial
triggerall = (GameMode = "arcade") && (Teammode = Single)
trigger1 = time = [0,250]
flag = roundnotover

[State 181, Win conditions]
type = AssertSpecial
triggerall = (GameMode = "arcade") && (Teammode = Single)
trigger1 = time = [0,300]
flag = RoundNotSkip

[State 181, Win conditions]
type = AssertSpecial
triggerall = (GameMode = "arcade" && Teammode != single) || GameMode != "arcade"
trigger1 = time = [0,200]
flag = RoundNotSkip

; Winpose Finish Starter
[State 181, 4]
type = AssertSpecial
triggerall = Matchover
trigger1 = time = [220,710]
flag = roundnotover

[State 181, 8]; Winquote background (Data)
type = Explod
triggerall = (GameMode = "arcade") && (Teammode = Single)
trigger1 = time = 220 && MatchOver
anim = F9001
pos = 0,0
postype = left
sprpriority = 7
ownpal = 1
removetime = 999999

[State 181, 8]; Anim SFZ (Data)
type = Explod
triggerall = (GameMode = "arcade") && (Teammode = Single)
trigger1 = time = 220 && MatchOver
anim = F9002
pos = 0,0
postype = left
sprpriority = 9
ownpal = 1
removetime = 999999

[State 181, 8]; Random Winquote (Data)
type =  Explod
triggerall = (GameMode = "arcade") && (Teammode = Single)
trigger1 = time = 220 && MatchOver
anim = F9005+(random%3)
pos = 0,0
postype = left
sprpriority = 9
ownpal = 1
removetime = 999999

[State 181, 8]; Winner (Chara)
type =  Explod
triggerall = (GameMode = "arcade") && (Teammode = Single)
trigger1 = time = 220 && MatchOver
anim = 9500
pos = 0,0
postype = left
sprpriority = 9
ownpal = 1
removetime = 999999

[State 181, 8]; Portrait (Chara)
type = Explod
triggerall = (GameMode = "arcade") && (Teammode = Single)
trigger1 = time = 230 && MatchOver
anim = 9501
pos = 0,0
postype = left
sprpriority = 6
ownpal = 1
removetime = 999999

[State 181, 16]; Remove elements
type = AssertSpecial
trigger1 = MatchOver = 1 && time >= 220 && Teammode != Simul
flag = nobardisplay
flag2 = noFG
flag3 = invisible

