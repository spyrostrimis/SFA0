;===========================================================================
; Run
;===========================================================================
; Forward
[Statedef 100]
type    = A
physics = N
ctrl = 0
anim = 100
sprpriority = 1

[state 181, 1]
type = playsnd
trigger1 = Time = 0
value = F100,0

[State 100, 1]
type = VelSet
trigger1 = Time = 0
x = const(velocity.run.fwd.x)
y = const(velocity.run.fwd.y)

[state 100, 2]
type = gravity
trigger1 = time >= 0

[state 100, 3]
type = veladd
trigger1 = time >= 0
x = -0.05

[State 100, 4]
type = CtrlSet
trigger1 = Time = 2
value = 1

[State 100, 5]
type = ChangeState
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 106

; Back
[Statedef 105]
type    = A
physics = N
ctrl = 0
anim = 105
sprpriority = 1

[state 181, 1]
type = playsnd
trigger1 = Time = 0
value = F100,0

[State 105, 1]
type = VelSet
trigger1 = Time = 0
x = const(velocity.run.back.x)
y = const(velocity.run.back.y)

[state 105, 2]
type = veladd
trigger1 = time >= 0
x = 0.05

[state 105, 3]
type = gravity
trigger1 = time >= 0

[State 105, 4]
type = ChangeState
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 106

