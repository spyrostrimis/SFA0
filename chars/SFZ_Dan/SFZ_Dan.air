;---------------------------------------------------------------------------
; PAGE-CUED COPY OF ACTION 7000 - generated by tools/endings/make_cue_anim.py.
; Do not hand-edit the frame list; regenerate it instead.
;
; Same frames and same entrances as 7000, except that the last frame of each
; shot WAITS instead of running out on gameticks. The ending text mod
; (external/mods/sfaz_ending_text.lua) advances it with ModifyExplod / animelem
; as the player pages through the text, so the shots change when the words do.
;
; The waits are a large finite duration, NOT -1, and that distinction is load
; bearing. Animation.Action() begins "if a.curFrame().Time <= 0 { next() }", so
; a -1 frame does not hold - it falls through, and next() then skips past every
; following -1 to the next frame with a positive duration. A -1 holds in exactly
; one place: the final frame of the action. Using it anywhere else makes every
; cue land on the last shot and the earlier sprites never appear at all.
;
; Action 7000 is left untouched and is still what plays if the mod is absent.
;---------------------------------------------------------------------------
[Begin Action 7010]
7000, 11, 0, 0, 999999     ; shot 1 starts here (animelem = 1)  ; group 1 waits here
-1, 0, 0, 0, 999999        ; shot 2 starts here (animelem = 2)  ; group 2 waits here
7000, 13, 0, 0, -1         ; shot 3 starts here (animelem = 3)  ; group 3 holds (-1 holds ONLY as the last frame)

;--------------------------------------------------------------------
; ENDING SPEAKER PORTRAITS
;
; One element per face; the 'faces' table in data/endings/ending_texts.lua
; indexes them 1-based, so element 1 = 7050,0. Time -1 on every element is
; correct - nothing animates, the .cns jumps straight to an element.
;
; The AXIS is what positions these. Crop each face with the axis that places it
; - (-51,-171) for the 308x52 strips, which is where the original art had it.
; The .cns draws the explod at the tunable offset alone, so FACE_OFFSET in
; external/mods/sfaz_ending_text.lua nudges the axis rather than replacing it.
;--------------------------------------------------------------------
[Begin Action 7050]
7050,0, 0,0, -1
