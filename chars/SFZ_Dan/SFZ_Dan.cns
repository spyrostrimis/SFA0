;===========================================================================
; Main Data
;===========================================================================
[Data]
life = 1000
power = 3000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 43
airjuggle = 15
sparkno = ifelse(teamside = 1,7,50007)
guard.sparkno = ifelse(teamside = 1,1,50001)
KO.echo = 1
volume = 255
IntPersistIndex = 30
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 20
ground.front = 18
air.back = 12
air.front = 12
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -70
mid.pos = -5, -50
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 3.0
walk.back = -2.0
jump.neu = 0,-9.2
jump.back = -3.5
jump.fwd = 3.0

[Movement]
airjump.num = 0
airjump.height = 28
yaccel = .4
stand.friction = .85
crouch.friction = .82

;===========================================================================
; Run
;===========================================================================
; Forward
[Statedef 100]
ttype    = S
physics = N
ctrl = 0
anim = 100
sprpriority = 1

[State 100, 1]
type = PlaySND
trigger1 = Time = 0
value = F100,0

[State 100, 1]
type = StateTypeSet
trigger1 = AnimElem = 3
StateType = A

[STate 1]
type = Velset
trigger1 = Time = 2
x = 9
y = -3

[state a]
type = veladd
trigger1 = animelem = 2,>0
y = 0.9

[state a]
type = velmul
trigger1 = 1
x = 0.95

[State 100, 3]
type = ChangeState
trigger1 = Pos Y >= 0 && Vel Y > 0
value = 101

[Statedef 101]
type = S
movetype = I
physics = S
anim = 101
velset = 0, 0

[State 1202, 1]
type = PosSet
trigger1 = Time = 0
Y = 0

[State 106,PlaySnd]
type = PlaySnd
trigger1 = Time = 1
value = F52,0

[State 106,End]
type = ChangeState
trigger1 = AnimTime = 0
value = 11
ctrl = 1

;---------------------------------------------------------------------------
; Back
[Statedef 105]
ttype    = S
physics = N
ctrl = 0
anim = 105
sprpriority = 1

[State 100, 1]
type = PlaySND
trigger1 = Time = 0
value = F100,0

[State 105, 1]
type = StateTypeSet
trigger1 = AnimElem = 3
StateType = A

[STate 1]
type = Velset
trigger1 = Time = 2
x = -9
y = -3

[state a]
type = veladd
trigger1 = animelem = 2,>0
y = 0.9

[state a]
type = velmul
trigger1 = 1
x = 0.95

[State 105, 3]
type = ChangeState
trigger1 = Pos Y >= 0 && Vel Y > 0
value = 106

[Statedef 106]
type = S
movetype = I
physics = S
anim = 106
velset = 0, 0

[State 1202, 1]
type = PosSet
trigger1 = Time = 0
Y = 0

[State 106,PlaySnd]
type = PlaySnd
trigger1 = Time = 1
value = F52,0

[State 106,End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;------------------
; Version anterior
;------------------
; Forward
[Statedef 104]
type    = S
physics = S
anim = 104
sprpriority = 1

[State 100, 1]
type = VelSet
trigger1 = 1
x = 6;const(velocity.run.fwd.x)

[State 100, 2]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = command != "holdfwd"
value = 11

[State 100, 4]
type = ChangeState
trigger1 = Time = 30
value = 11

;---------------------------------------------------------------------------
; Back
[Statedef 109]
type    = S
physics = S
anim = 109
sprpriority = 1

[State 100, 1]
type = VelSet
trigger1 = 1
x = -6;const(velocity.run.fwd.x)

[State 100, 2]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = command != "holdback"
value = 11

[State 100, 4]
type = ChangeState
trigger1 = Time = 30
value = 11

;===========================================================================
; TIME OVER
;===========================================================================
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0

[State 170, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

;===========================================================================
; Winner Pos
;===========================================================================
[Statedef 180]
type = S

[State 181, Perfect msg]
type = Explod
triggerall = WinPerfect
trigger1 = (IsHomeTeam = 0) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
anim = F180
pos = 0,-5
sound = F180,180
postype = Left
facing = 1
sprpriority = 9
ownpal = 0

[State 181, Perfect Voice]
type = PlaySnd
triggerall = WinPerfect
trigger1 = (IsHomeTeam = 0) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
trigger1 = time = 0
value = F180,180
Loop = 0

[State 181, Win Voice]
type = PlaySnd
triggerall = WinKO = 1
trigger1 = (IsHomeTeam = 0) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
value = F3,1
Loop = 0

[State 181, Lose Voice]
type = PlaySnd
triggerall = WinKO = 1
trigger1 = (IsHomeTeam = 1) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
value = F3,2
Loop = 0

[State 180, 2]; Boss Battle
type = ChangeState
trigger1 = Time = 0
trigger1 = var(44) = 1
trigger1 = matchover
value = 189
[State 180, 2]; Shin Akuma
type = ChangeState
trigger1 = Time = 0
trigger1 = var(43) = 1
trigger1 = matchover
value = 188

[State 180, 1]
type = VarRandom
trigger1 = 1
v = 10
range = 1,5

[State 180, 2] ;Choose win 1
type = VarSet
trigger1 = Command = "hold_x"
v = 10
value = 1

[State 180, 3] ;Choose win 2
type = VarSet
trigger1 = Command = "hold_a"
v = 10
value = 2

[State 180, 4] ;Choose win 3
type = VarSet
trigger1 = Command = "hold_y"
v = 10
value = 3

[State 180, 4] ;Choose win 4
type = VarSet
trigger1 = Command = "hold_b"
v = 10
value = 4

[State 180, 4] ;Choose win 5
type = VarSet
trigger1 = Command = "hold_z"
v = 10
value = 5

[State 180, 4] ;Choose win 5
type = VarSet
trigger1 = Command = "hold_c"
v = 10
value = 5

[State 180, 2]
type = ChangeState
trigger1 = Var(10) = 1
value = 181

[State 180, 3]
type = ChangeState
trigger1 = Var(10) = 2
value = 182

[State 180, 4]
type = ChangeState
trigger1 = var(10) = 3
value = 183

[State 180, 4]
type = ChangeState
trigger1 = var(10) = 4
value = 184

[State 180, 4]
type = ChangeState
trigger1 = var(10) = 5
value = 185

