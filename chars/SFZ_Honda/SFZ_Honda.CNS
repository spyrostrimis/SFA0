;===========================================================================
; Archive Emanuel Honda            
;===========================================================================
; Data principal
;===========================================================================
[Data]
life = 1000
power = 3000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 43
airjuggle = 15
sparkno = ifelse(teamside = 1,7,50007)
guard.sparkno = ifelse(teamside = 1,1,50001)
KO.echo = 1
volume = 5
IntPersistIndex = 30
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 47
ground.front = 30
air.back = 30
air.front = 15
z.width = 3
height = 50
attack.width = 4,4
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = 0, -67
mid.pos = 0, -45
shadowoffset = 0

[Velocity]
walk.fwd  = 2.4
walk.back = -1.6
run.fwd  = 4.6,0
run.back = -4.5,-3.8
jump.neu = 0,-8.1
jump.back = -3.30
jump.fwd = 3.4
runjump.back = -2.55,-8.1
runjump.fwd = 4,-8.1
airjump.neu = 0,-8.1
airjump.back = -2.55,-8.1
airjump.fwd = 2.5,-8.1

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .43
stand.friction = .85
crouch.friction = .82

;===========================================================================
; Run
;===========================================================================
[Statedef 100]
type = S
movetype = I
physics = S
anim = 102
ctrl = 0
velset = 0, 0

[State 110,StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 2
statetype = A
physics = N

[State 110,VelSet]
type = VelSet
trigger1 = AnimElem = 2
x = Const(velocity.run.back.x)*-1
y = Const(velocity.run.back.y)

[State 105,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 2
value = F100,0

[State 105, VelMul]
type = VelAdd
trigger1 = AnimElem = 2, > 0
x = .2

[State 105,VelAdd]
type = VelAdd
trigger1 = AnimElem = 2, > 0
y = .55

[State 105,VelAdd]
type = VelSet
trigger1 = AnimElem = 2, > 0
trigger1 = Vel Y > 0 && Pos Y >= 0
x = 0

[State 110,End]
type = ChangeState
trigger1 = AnimElem = 2, > 0
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 101

[Statedef 101]
type = S
movetype = I
physics = S
anim = 103
velset = 0, 0

[State 111,PlaySnd]
type = PlaySnd
trigger1 = Time = 1
value = F52,0

[State 111,End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
  
