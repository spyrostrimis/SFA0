; The looping background scroll, page 6 to the end. Triggered on page 6's own
; tick (1606) and never removed, so the derivation binds it 6..end with no help
; from the script file. Same sprpriority as F13300, which is blank by then, so
; it simply takes over.
[State 181, Stage - scrolling]
type = Explod
trigger1 = time = 1606 && MatchOver && Map(sfaz_end_active) = 0
anim = F13301
ID = 10000
pos = 0,0
postype = left
sprpriority = 3
removetime = 999999

