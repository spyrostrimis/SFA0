trigger1 = !Alive
trigger2 = MoveType != H
trigger2 = Var(15) >= 15
trigger3 = UniqHitCount > 6
trigger4 = GetHitVar(hitcount) > 6
ignorehitpause = 1
v = 15
value = 0

