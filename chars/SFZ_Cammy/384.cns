;=====================================================================
; Data Principal
;=====================================================================
[Data]
life = 1000
power = 3000
attack = 100
defence = 110
fall.defence_up = 50
liedown.time = 43
airjuggle = 15
sparkno = ifelse(teamside = 1,7,50007)
guard.sparkno = ifelse(teamside = 1,1,50001)
KO.echo = 1
volume = 255
IntPersistIndex = 30
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 20
ground.front = 18
air.back = 12
air.front = 12
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -73
mid.pos = -5, -53
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 3.9
walk.back = -2.9
jump.neu = 0,-9.5
jump.back = -3.5
jump.fwd = 3.0

[Movement]
airjump.num = 0
airjump.height = 28
yaccel = .4
stand.friction = .85
crouch.friction = .82

;=====================================================================
; WinPos States
;=====================================================================
[Statedef 180]
type = S

[State 181, Perfect msg]
type = Explod
triggerall = WinPerfect
trigger1 = (IsHomeTeam = 0) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
anim = F180
pos = 0,-5
sound = F180,180
postype = Left
facing = 1
sprpriority = 9
ownpal = 0

[State 181, Perfect Voice]
type = PlaySnd
triggerall = WinPerfect
trigger1 = (IsHomeTeam = 0) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
trigger1 = time = 0
value = F180,180
Loop = 0

[State 181, Win Voice]
type = PlaySnd
triggerall = WinKO = 1
trigger1 = (IsHomeTeam = 0) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
value = F3,1
Loop = 0

[State 181, Lose Voice]
type = PlaySnd
triggerall = WinKO = 1
trigger1 = (IsHomeTeam = 1) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
value = F3,2
Loop = 0

