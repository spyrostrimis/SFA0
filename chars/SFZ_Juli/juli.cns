[Data]
life = 1000          
attack = 110         
defence = 100        
fall.defence_up = 50 
liedown.time = 30    
airjuggle = 15      
sparkno = ifelse(teamside = 1,5,50005)        
guard.sparkno = ifelse(teamside = 1,0,50000) ;Default guard spark number
KO.echo = 1          ;1 to enable echo on KO
volume = -245
IntPersistIndex = 30
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 20
ground.front = 18
air.back = 12
air.front = 12
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -73
mid.pos = -5, -53
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 2.9        ;Walk forward
walk.back = -2.5       ;Walk backward
run.fwd  = 8           ;Run forward (x, y)  - if y<0, player will hop
run.back = -6, -4.5    ;Run backward (x, y) - if y=0, player will run
jump.neu = 0,-9.5      ;Neutral jumping velocity (x, y)
jump.back = -3.2,-9.2  ;Jump back Speed (x, y)
jump.fwd = 3.2,-9.2    ;Jump forward Speed (x, y)
runjump.back = -4,-8.5 ;Running jump speeds (opt)
runjump.fwd = 4,-8.5   

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
yaccel = .4          ;Vertical acceleration
stand.friction = .8  ;Friction coefficient when standing
crouch.friction = .8 ;Friction coefficient when crouching

