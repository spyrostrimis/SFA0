type    = S
physics = N
ctrl = 0
anim = 105
sprpriority = 1

[State 100, 1]
type = PlaySND
trigger1 = Time = 0
value = F100,0

[State 105, 1]
type = StateTypeSet
trigger1 = AnimElem = 3
StateType = A

[STate 1]
type = Velset
trigger1 = Time = 2
x = -10
y = -3

[state a]
type = veladd
trigger1 = animelem = 3,>0
y = 0.9

[state a]
type = velmul
trigger1 = 1
x = 0.95

[State 105, 3]
type = ChangeState
trigger1 = Pos Y >= 0 && Vel Y > 0
value = 106

