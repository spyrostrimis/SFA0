;===========================================================================
; TIME OVER
;===========================================================================
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0

; vs U-Sagat
[State -2]
type = ChangeState
;trigger1 = EnemyNear,NumPartner = 0 && NumPartner = 0 
trigger1 = P2Name = "Sagat" && EnemyNear,AuthorName = "Ehnyd"
;trigger1 = matchno = 10 && IsHomeTeam = 1
;trigger1 = StageVar(info.name) = "Boss Buddha"
value = 1890

[State 170, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

;===========================================================================
; Winner
;===========================================================================
[Statedef 180]
type = S
ctrl = 0
anim = 180
velset = 0,0

[State 181, Perfect msg]
type = Explod
triggerall = WinPerfect
trigger1 = (IsHomeTeam = 0) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
anim = F180
pos = 0,-5
sound = F180,180
postype = Left
facing = 1
sprpriority = 9
ownpal = 0

[State 181, Perfect Voice]
type = PlaySnd
triggerall = WinPerfect
trigger1 = (IsHomeTeam = 0) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
trigger1 = time = 0
value = F180,180
Loop = 0

[State 181, Win Voice]
type = PlaySnd
triggerall = WinKO = 1
trigger1 = (IsHomeTeam = 0) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
value = F3,1
Loop = 0

[State 181, Lose Voice]
type = PlaySnd
triggerall = WinKO = 1
trigger1 = (IsHomeTeam = 1) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
value = F3,2
Loop = 0

[State 180, 0] ;Ken
type = ChangeState
trigger1 = Var(11) = 1 && MatchOver = 1
value = 186

[State 180, 2]; Akuma
type = ChangeState
trigger1 = Time = 0
trigger1 = var(43) = 1
trigger1 = matchover
value = 188

[State 180, 1]
type = VarRandom
trigger1 = 1
v = 10
range = 1,5

[State 180, 2] ;Choose win 1
type = VarSet
trigger1 = Command = "hold_x"
v = 10
value = 1

[State 180, 3] ;Choose win 2
type = VarSet
trigger1 = Command = "hold_a"
v = 10
value = 2

[State 180, 4] ;Choose win 3
type = VarSet
trigger1 = Command = "hold_y"
v = 10
value = 3

[State 180, 4] ;Choose win 4
type = VarSet
trigger1 = Command = "hold_b"
v = 10
value = 4

[State 180, 4] ;Choose win 5
type = VarSet
trigger1 = Command = "hold_z"
v = 10
value = 5

[State 180, 4] ;Choose win 6
type = VarSet
trigger1 = Command = "hold_c"
v = 10
value = 5

[State 180, 2]
type = ChangeState
trigger1 = Var(10) = 1
value = 184

[State 180, 3]
type = ChangeState
trigger1 = Var(10) = 2
value = 182

[State 180, 4]
type = ChangeState
trigger1 = var(10) = 3
value = 183

[State 180, 4]
type = ChangeState
trigger1 = var(10) = 4
value = 184

[State 180, 4]
type = ChangeState
trigger1 = var(10) = 5
value = 185

