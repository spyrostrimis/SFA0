trigger1 = Time > 10
trigger1 = Vel X > 0
x = -0.5

[State 100, 3]
type = ChangeState
trigger1 = Time >= 20
trigger1 = AnimTime = 0
trigger2 = Vel Y > 0
trigger2 = Pos Y >= 0
trigger3 = Vel X <= 0
trigger3 = Vel Y >= 0
