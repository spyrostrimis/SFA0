yscale = 1
ground.back = 30
ground.front = 30
air.back = 20
air.front = 20
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 1
head.pos = -5, -80
mid.pos = -5, -50
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 4
walk.back = -3
run.fwd  = 6,0
run.back = -5,0
jump.neu = 0,-9
jump.back = -3
jump.fwd = 3
runjump.back = -4,-8
runjump.fwd = 4,-8
airjump.neu = 0,-9
airjump.back = -3
airjump.fwd = 3

[Movement]
