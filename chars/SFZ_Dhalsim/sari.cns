;looking right
[State 4000, 右]
type = changestate
trigger1 = rootdist X > 0
value = 4001

;happy/clapping
[State 4000, 喜]
type = changestate
trigger1 = time > 10 && p2stateno = [5000,5070]
value = 4010

;looking back/sad
[State 4000, 哀]
type = changestate
trigger1 = time > 10 && root, stateno = [5000,5070]
value = 4020

;dhalsim wins
[State 4000, 大喜]
type = changestate
trigger1 = root, stateno = [181,186]
value = 4030

;dhalsim defeated
[State 4000, 泣]
type = changestate
trigger1 = (root, stateno = 170) || (root, stateno = 5150)
value = 4040

