;---------------------------------------------------------------------
; ENDING SPEAKER PORTRAIT
;
; Only runs while the mod is driving the ending (Map(sfaz_end_active) != 0).
; With the mod absent the original text sprites still carry the face baked in,
; so nothing here fires and the old look is untouched.
;
; sfaz_end_face is the element inside [Begin Action 7050], 1-based, or 0 on a
; page with no portrait.
;
; pos carries ONLY the tunable offset - the SPRITE AXIS does the positioning,
; the same way every other explod in this ending is drawn at pos = 0,0. Adding
; the art's own 51,171 here as well draws the face at double the offset, off the
; bottom of the screen, with no error anywhere.
;
; animelem, not anim: ModifyExplod's anim parameter is gated on the character
; declaring an ikemenversion and this one does not, so it would silently do
; nothing. Same reason the picture cues use animelem.
;
; sprpriority 8 keeps the original relationship. The old text sprite that
; carried the face sat at 6, above the frame's then-5; the mod raises that
; frame to 7, so the portrait has to clear it.
;---------------------------------------------------------------------
[State 181, ending portrait]
type = Explod
trigger1 = MatchOver && Map(sfaz_end_active) != 0
trigger1 = Map(sfaz_end_face) > 0 && NumExplod(10050) = 0
anim = 7050
ID = 10050
pos = Map(sfaz_end_face_x), Map(sfaz_end_face_y)
postype = left
sprpriority = 8
ownpal = 1
removetime = 999999

[State 181, ending portrait - cue]
type = ModifyExplod
trigger1 = NumExplod(10050) && Map(sfaz_end_face) > 0
ID = 10050
animelem = Map(sfaz_end_face)
pos = Map(sfaz_end_face_x), Map(sfaz_end_face_y)
postype = left

[State 181, ending portrait - off]
type = RemoveExplod
trigger1 = NumExplod(10050) && Map(sfaz_end_face) = 0
ID = 10050

[State 181, 16]; Remove elements
type = AssertSpecial
trigger1 = MatchOver = 1 && time >= 0
flag = nobardisplay
flag2 = noFG
flag3 = invisible

[State 181, 8]; Fade to black
type = Explod
trigger1 = time = 2161 && MatchOver && Map(sfaz_end_active) = 0
anim = F9999
pos = 0,0
postype = left
sprpriority = 9
ownpal = 1
removetime = 999999

[State 162, 9]
type = changestate
trigger1 = Time = 2165 && Map(sfaz_end_active) = 0
value = 18801


; When the mod is driving there is no such tick - the ending leaves for the
; outro state the moment the last page is dismissed.
[State 162, 9 - ending text finished]
type = changestate
trigger1 = Map(sfaz_end_active) != 0 && Map(sfaz_end_done) != 0
value = 18802

; --- THE ENDING IS NOT SKIPPABLE BY A BUTTON ------------------------------
; Without this, EVERY press that turns a page also ends the whole ending.
;
; System.draw does:
;     if !winskipped && winposetime < 0 && anyButton() && !roundnotskip { ... }
;         winskipped = true
;     if intro == fadeoutStart && (!roundnotover || winskipped) { fadeOut.init() }
;
; so anyButton() sets winskipped, and winskipped OVERRIDES roundnotover - the
; round fades out however long the ending still wants to run. The characters
; assert RoundNotSkip for the first 100 ticks at most, and Ryu not at all, which
; was harmless while an ending was a non-interactive clock nobody pressed
; anything during. Now that paging IS pressing a button, it fired on every page
; turn and read as "any key ends the ending".
;
; Asserted only on the driven path: the fallback ending still behaves exactly as
; it always did.
[State 181, Ending not skippable]
type = AssertSpecial
triggerall = MatchOver
trigger1 = Map(sfaz_end_active) != 0
flag = RoundNotSkip

; --- PAGE CUES ------------------------------------------------------------
; Generated by tools/endings/convert_cns.py. Identical for every character:
; the .cns never learns how many pages there are or which one is showing, only
; "put layer k on element N". All the per-character knowledge is in the Lua.
;
; The latch is what turns "the value changed" into a SINGLE firing, which
; matters because a shot can be animated - re-issuing animelem every frame
; would restart its entrance forever. Latches must stay AFTER every cue.

[State 181, Cue layer 1]
type = ModifyExplod
trigger1 = Map(sfaz_end_active) != 0 && Map(sfaz_end_cue1) > 0
trigger1 = Map(sfaz_end_cue1) != Map(sfaz_end_ack1)
ID = 10001
animelem = Map(sfaz_end_cue1)

[State 181, Cue layer 2]
type = ModifyExplod
trigger1 = Map(sfaz_end_active) != 0 && Map(sfaz_end_cue2) > 0
trigger1 = Map(sfaz_end_cue2) != Map(sfaz_end_ack2)
ID = 10002
animelem = Map(sfaz_end_cue2)

[State 181, Cue latch 1]
type = MapSet
trigger1 = Map(sfaz_end_active) != 0
map = "sfaz_end_ack1"
value = Map(sfaz_end_cue1)

[State 181, Cue latch 2]
type = MapSet
trigger1 = Map(sfaz_end_active) != 0
map = "sfaz_end_ack2"
value = Map(sfaz_end_cue2)

; --- SHOT TRANSITION ------------------------------------------------------
[State 181, Shot transition]
type = Explod
trigger1 = Map(sfaz_end_active) != 0 && Map(sfaz_end_flash) != Map(sfaz_end_flashack)
anim = F9999
ID = 10099
pos = 0,0
postype = left
sprpriority = 5
ownpal = 1
removetime = 40

[State 181, Shot transition latch]
type = MapSet
trigger1 = Map(sfaz_end_active) != 0
map = "sfaz_end_flashack"
value = Map(sfaz_end_flash)

;---------------------------------------------------------------------------
; Ending outro. Only reached on the mod-driven path. A separate state rather
; than more latches in 18800, precisely because entering one resets time to 0 -
; which gives the fade and the hand-over an honest little clock again instead
; of more map values to keep in step. Mirrors the last few ticks of the
; original tail.
[Statedef 18802]
type = S
physics = S
ctrl = 0
anim = 0
velset = 0,0

[State 181, 4]
type = AssertSpecial
triggerall = Matchover
trigger1 = 1
flag = roundnotover

; The press that dismissed the last page is still in the buffer when this state
; begins; without this it would set winskipped here instead.
[State 181, 4b]
type = AssertSpecial
triggerall = Matchover
trigger1 = 1
flag = RoundNotSkip

[State 181, 7]; Stop Music
type = AssertSpecial
trigger1 = Matchover
flag = NoMusic

[State 181, 16]; Remove elements
type = AssertSpecial
trigger1 = MatchOver = 1
flag = nobardisplay
flag2 = noFG
flag3 = invisible

[State 181, 8]; Stage
type = Explod
trigger1 = time = 5 && MatchOver
anim = F9999
pos = 0,0
postype = left
sprpriority = 9
ownpal = 1
removetime = 999999

[State 162, 9]
type = changestate
trigger1 = Time = 10
value = 18801

