;-------------------------------------------------------------------------------
; Spiral Arrow
;------------------------
[Statedef 1000]
type = S
movetype = A
physics = S
velset = 0, 0
ctrl = 0
anim = 1000
poweradd = 84 + (Var(31) != 0) * 42
juggle = 7

[State 1000,VarSet]
type = VarSet
trigger1 = Time = 0
v = 1
value = 0

[State 1000,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 3
value = 1100, 1

[State 1000,Attack]
type = HitDef
trigger1 = Time = 0
attr = S, SA
damage    = Floor(84 * IfElse(Var(31) = 0,1,IfElse(Var(31) = -1,1.2,0.8))),Floor(84 * IfElse(Var(31) = 0,0.125,IfElse(Var(31) = -1,0.3,0.05)))
animtype = Hard
getpower = 63 + (Var(31) != 0) * 21
givepower = 15 + (Var(31) != 0) * 5
guardflag = L
hitflag = MAF
pausetime = 10,10
sparkno = ifelse(teamside = 1,8,50008)
guard.sparkno = ifelse(teamside = 1,1,50001)
sparkxy = -10,-24
hitsound = F5,2
hitsound.channel = 12
guardsound = F6, 0
ground.type = High
ground.slidetime = 7
ground.hittime  = 15
ground.velocity = -5.0,-5.5
air.velocity = -5.0,-4.5
fall = 1
fall.recover = 0
air.recover = 0
recover = 0

[State 1000,ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 1010

