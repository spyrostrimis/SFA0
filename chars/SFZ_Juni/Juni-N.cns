; Dash
[Statedef 100]
type=S
physics=N
movetype=I
anim=101
ctrl=0
sprpriority=1

[State 100, 1]
type = PlaySND
trigger1 = Time = 0
value = F100,0

[State 102, Type]
type=statetypeset
trigger1= animelemtime(2)>=0
statetype=A
physics=N
[State 102, Accel]
type=veladd
trigger1= animelemtime(2)>=0
y= .665

[State 102, Vel]
type=velset
trigger1= animelem=2
x= 5.738
y= -5.132

[State 102, End]
type = changestate
trigger1 = animelemtime(2)>=0
trigger1 = pos y>-vel y
value = 101

