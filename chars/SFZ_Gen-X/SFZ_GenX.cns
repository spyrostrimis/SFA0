triggerall = GetHitVar(hitcount) <= 6
triggerall = StateNo >= 5000
trigger1 = MoveType = H
trigger1 = !HitShakeOver
trigger1 = Time = 0
ignorhitpause = 1
v = 15
value = 1

[State -2, Hit Subtract]
type = VarAdd
triggerall = MoveType != H
triggerall = Var(15) > 0
trigger1 = Time > 0
trigger1 = TimeMod = 40,0
v = 15
value = -1

[State -2, Hit Max]
