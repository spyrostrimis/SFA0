trigger1 = MoveType = H
trigger1 = !Alive
trigger2 = MoveType != H
trigger2 = Var(15) >= 15
trigger3 = UniqHitCount > 6
trigger4 = GetHitVar(hitcount) > 6
ignorehitpause = 1
v = 15
value = 0

[State -2, VarSet]
type = VarSet
trigger1 = MoveType = H
trigger1 = !HitShakeOver
trigger1 = StateNo != 5400
trigger1 = StateNo != 5410
trigger2 = StateNo = 0
ignorehitpause = 1
v = 5
value = 0

