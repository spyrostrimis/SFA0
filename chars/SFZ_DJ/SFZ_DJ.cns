trigger1 = Anim = 5120
trigger1 = AnimElem = 1
value = 10, 0
channel = 0

[State 190, 5] ;Change to stand state
type = ChangeState
trigger1 = Anim = 5120
trigger1 = AnimTime = 0
value = 0

