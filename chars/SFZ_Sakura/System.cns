[State -2]
type = AfterImageTime
trigger1 = Ctrl = 1
trigger2 = MoveType = H
trigger3 = Anim = 3002 || Anim = 3012 || Anim = 3022
trigger4 = Anim = 3100 && AnimElem = 25
time = 0

[State -2]
type = PlaySnd
trigger1 = Time = 1 && Anim = 5200
trigger2 = Time = 1 && Anim = 5210
value = s20,5

[State -2, Valor barra defensa]
type = VarRangeSet
trigger1 = roundstate = [0,1]
trigger2 = Ctrl = 0 && (Anim = [0,1]) && MoveType != H
first = 12
last = 13
value = 50

; corregir
[State -2, Guard Points Recover]
type = varadd
triggerall = var(12) < var(13)
trigger1 = gametime%50 = 1 && movetype = I
trigger2 = gametime%40 = 1 && movetype = A
v = 12
value = 1

[State -3, Display Guard Points]
type = displaytoclipboard
trigger1 = 1
text = "guard = %d  Stunned:%d"
params = var(12), Var(15)

[State -3, 2]
type = PlaySnd
triggerall = Time = 1
triggerall = Life
triggerall = random % 10 < 5
trigger1 = stateno = 5000
trigger1 = anim = 5000 || anim = 5010
trigger2 = stateno = 5010
trigger2 = anim = 5020
value = 5000,20
ignorehitpause = 1


[State -3, 2]
type = PlaySnd
triggerall = Time = 1
triggerall = Life
triggerall = random % 10 < 4
trigger1 = stateno = 5020
value = 5000,0
ignorehitpause = 1

