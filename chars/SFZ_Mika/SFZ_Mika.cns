;===========================================================================
; Archive Rainbow Mika
;===========================================================================
; Main data
;===========================================================================
[Data]
life = 1000
power = 3000
attack = 120
defence = 100
fall.defence_up = 50
liedown.time = 43
airjuggle = 15
sparkno = ifelse(teamside = 1,7,50007)
guard.sparkno = ifelse(teamside = 1,1,50001)
KO.echo = 1
volume = -145
IntPersistIndex = 30
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 20
ground.front = 20
air.back = 20
air.front = 20
height = 75
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = 14, -80
mid.pos = 3, -56
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 3.4
walk.back = -2.4
run.fwd  = 4.6, 0
run.back = -4.9,-2.2
jump.neu = 0,-8.38
jump.fwd = 3.33
jump.back = -3.90
runjump.back = -2.55,-8.1
runjump.fwd = 4,-8.1

[Movement]
yaccel = .44
stand.friction = .85
crouch.friction = .82

;===========================================================================
; Run
;===========================================================================
; Dash
[Statedef 100]
type=S
physics=N
movetype=I
anim=100
ctrl=0
sprpriority=1

[State 100, 1]
type = PlaySND
trigger1 = Time = 0
value = F100,0

[State 102, Type]
type=statetypeset
trigger1= animelemtime(2)>=0
statetype=A
physics=N
[State 102, Accel]
type=veladd
trigger1= animelemtime(2)>=0
y= .665

[State 102, Vel]
type=velset
trigger1= animelem=2
x= 5.738
y= -5.132

[State 102, End]
type = changestate
trigger1 = animelemtime(2)>=0
trigger1 = pos y>-vel y
value = 101

; Frenar
[Statedef 101]
type    = S
physics = S
anim = 101
ctrl = 0
velset = 0,0

[State 100, 1]
type = PlaySND
trigger1 = Time = 0
value = F52,0

[State 101, 1]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 101, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 101, 3]
type = ChangeState
trigger1 = Time > 3
value = 0
ctrl = 1

