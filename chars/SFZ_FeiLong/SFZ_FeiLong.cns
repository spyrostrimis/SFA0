;===========================================================================
; Archive Fei Long
;===========================================================================
; Standing Actions
;===========================================================================
[Data]
life = 1000
power = 3000
attack = 150
defence = 100
fall.defence_up = 50
liedown.time = 43
airjuggle = 15
sparkno = ifelse(teamside = 1,7,50007)
guard.sparkno = ifelse(teamside = 1,1,50001)
KO.echo = 1
volume = 255
IntPersistIndex = 30
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 15
ground.front = 16
air.back = 12
air.front = 12
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -70
mid.pos = -5, -40
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 3
walk.back = -3
run.fwd  = 5, 0
run.back = -4,-6
jump.neu = 0,-8.5
jump.back = -3
jump.fwd = 3
runjump.back = -4,-8
runjump.fwd = 4,-8
airjump.neu = 0,-8
airjump.back = -3
airjump.fwd = 3

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .44
stand.friction = .85
crouch.friction = .80

;===========================================================================
; Run
;===========================================================================
[Statedef 100]
type=S
physics=N
movetype=I
anim=100
ctrl=0
sprpriority=1

[State 100, 1]
type = PlaySND
trigger1 = Time = 0
value = F100,0

[State 102, Type]
type=statetypeset
trigger1= animelemtime(1)>=0
statetype=S
physics=N

[State 102, Vel]
type=velset
trigger1= animelem=2
x= 7.738

[State 102, Vel]
type=velset
trigger1= animelem=4
x= 0

[State 102, End]
type=changestate
trigger1= Animtime= 0
value = 0
ctrl = 1

[Statedef 105]
type    = S
physics = N
ctrl = 0
anim = 105
sprpriority = 1

[State 100, 1]
type = PlaySND
trigger1 = Time = 0
value = F100,0

[State 105, 1]
type = StateTypeSet
trigger1 = AnimElem = 2
StateType = A

[STate 1]
type = Velset
trigger1 = Time = 2
x = -10
y = -4

[state a]
type = veladd
trigger1 = animelem = 2,>0
y = 1;0.9

[state a]
type = velmul
trigger1 = 1
x = 0.95

[State 105, 3]
type = ChangeState
trigger1 = Pos Y >= 0 && Vel Y > 0
value = 106

[Statedef 106]
type = S
physics = S
ctrl = 0
anim = 106
velset = 0, 0

[State 106, Pos]
type = posset
trigger1 = 1
y = 0

[State 106, Ctrl]
type = ctrlset
trigger1 = time >= 2
value = 1

[State 106, End]
type = changestate
trigger1 = !animtime
value = 0
ctrl = 1

