trigger1 = matchno = 9 && IsHomeTeam = 0
hidebars = 1
text1 = "<p1>Ryu... It's time! Fight me!"
text2 = "<p1>Now you will finally see that I am the strongest! Not you!"
text3 = "<p2>Ken? What's wrong? What's happened to you?!"
text4 = "<p1>Shut up!! Don't assume that I'm what I once was! We fight!!"

[State 191, Dialogue]
