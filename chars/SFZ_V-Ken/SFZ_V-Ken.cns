trigger1 = matchno = 5 && IsHomeTeam = 0
hidebars = 1
text1 = "<p2>Ken Masters, what happened to you?"
text2 = "<p1>I am the strongest fighter of all!!"
text3 = "<p2>The strongest fighter is the one who abandons greed."
text4 = "<p1>Those words mean nothing to me!!"

[State 191, Dialogue]
