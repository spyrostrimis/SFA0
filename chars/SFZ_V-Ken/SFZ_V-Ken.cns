trigger1 = matchno = 10 && IsHomeTeam = 0
hidebars = 1
text1 = "<p1>Bison! You'll pay for what you've done to me!"
text2 = "<p2>Look at you! Can't you see how magnificent you've become?"
text3 = "<p2>Just like me!..."
text4 = "<p1>I'm not like you. Not even a bit!"

