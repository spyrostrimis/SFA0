;===========================================================================
; Data principal
;===========================================================================
[Data]
life = 1000
power = 3000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 43
airjuggle = 15
sparkno = ifelse(teamside = 1,7,50007)
guard.sparkno = ifelse(teamside = 1,1,50001)
KO.echo = 1
volume = 255
IntPersistIndex = 30
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 25
ground.front = 20
air.back = 18
air.front = 18
z.width = 10
height = 50
attack.width = 4,4
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = 4,-90
mid.pos = -14,-64
shadowoffset = 2

[Velocity]
walk.fwd  = 4.10
walk.back = -3.30
run.fwd  = 5.50, 0
run.back = -4.80, 0
jump.neu = 0,-11.5
jump.fwd = 4.30
jump.back = -3.80

[Movement]
airjump.num = 0
;airjump.height = 35
yaccel = .60
stand.friction = .85
crouch.friction = .82

;===========================================================================
; Run
;===========================================================================
; Forward
[Statedef 100]
type    = S
physics = N
ctrl = 0
