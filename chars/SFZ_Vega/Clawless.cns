;-------------------------------
; Claw (pick up)
;-------------------------------
[StateDef 29000]
type = S
movetype = I
physics = S
anim = 29030
ctrl = 0
velSet = 0,0
sprPriority = 1
powerAdd = 0
faceP2 = 1

[State 0, Var]; Activate knife mode
type = VarSet
trigger1 = Time = 0
var(29) = 0

[State 0, Snd]
type = PlaySnd
trigger1 = AnimElem = 3
value = 500,9

[State 0, Snd]
type = PlaySnd
trigger1 = AnimElem = 1
value = 800,0

[State 0,End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


;===========================================================================
; Helper: Claw
;------------------
;Knife
[Statedef 29500]
type = A
movetype = I
physics = N
ctrl = 0
anim = 29000
velset = ifelse(BackEdgeDist>180,-3,3),-15
SprPriority = -1

[State 8012, Assert: NoShadow]
type = AssertSpecial
trigger1 = 1
flag = NoShadow
ignoreHitPause = 1

[State 0, snd]
type = PlaySnd
triggerall = !enemy, movetype = H || frontedgedist < 1
trigger1 = Time = 0
value = 1900,3

[state -3]
type = parentVarSet
trigger1 = Time = 0
var(29) = 1

[State 0,Vel]
type = VelAdd
trigger1 = 51
y = 1.55

[State 0,End]
type = ChangeState
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 28000

;Knife
[Statedef 28000]
type = L
movetype = I
physics = N
ctrl = 0
anim = 29010
velset = 0, 0
SprPriority = -1

[State 8012, Assert: NoShadow]
type = AssertSpecial
trigger1 = 1
flag = NoShadow
ignoreHitPause = 1

[State 0, var]
type = parentvarset
trigger1 = parent, var(29)
var(45) = 160

[State 0, Pos]
type = PosSet
trigger1 = Time = 0
Y = 0

[State 0, die]
type = destroyself
trigger1 = numhelper(15000) > 1 || (enemy, numhelper(28000) > 1 && !teamside)
trigger2 = parent, var(29) = 0 || (enemy, var(29) = 0 && enemy, name = "Vega/Claw")
trigger3 = parent, var(17) && !parent, var(29)
trigger4 = helper, stateno = 29500 || enemy, numhelper(28000)

;Knife
[Statedef 28001]
type = L
movetype = I
physics = S
ctrl = 0
anim = 29020
velset = 0, 0
SprPriority = -1

[state -3]
type = Parentvarset
trigger1 = Time = 0
var(17) = 0

[State 0, Die]
type = DestroySelf
trigger1 = Time = 0

;===========================================================================
; Override States for Clawless Vega
;===========================================================================
;Stand
[StateDef 0]
type = S
physics = S
moveType = I
velSet = 0,0
sprPriority = 0

[State -7, 5] ;Are you floating?
type = ChangeState
triggerall = pos y < 0
trigger1 = time > 1
value = 52

[State -2, PlayDialogueMusic]
type = PlaySnd
trigger1 = MotifState(dialogue) && !MotifState(demo)
value = F7777,0
channel = 25
persistent = 0

[State -2, StopDialogueMusic]
type = StopSnd
trigger1 = RoundState = 2
channel = 25
persistent = 0

[State -2, 3] ;Hyper
type = PowerAdd
triggerall = TeamSide = 1
triggerall = gamemode = "worldtour"
triggerall = matchno = 16 || matchno = 21
trigger1 = power < 3000
value = 3000

[State 0, PlaySound]
type = PlaySnd
trigger1 = GameMode = "timeattack"
trigger1 = Player(1), ConsecutiveWins = 9
trigger1 = (stateno = 0 && roundstate = 1 && p2stateno = 0) && Time = 1
value = F0,10
channel = 0
ctrl = 0
ignorehitpause = 1


[State 181, 8] ; Final Round
type = Explod
trigger1 = GameMode = "timeattack"
trigger1 = Player(1), ConsecutiveWins = 9
trigger1 = (stateno = 0 && roundstate = 1 && p2stateno = 0) && Time = 1
anim = F910
ID = 910
pos = 100,35
postype = left
sprpriority = 8
removetime = 70
ctrl = 0
persistent = 0
ignorehitpause = 1


[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = roundstate = 1 && Time = 70
explod = 910

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = (var(40) != 1 && anim != 0 + Var(29)*10000) || (var(40) = 1 && anim != 2 + Var(29)*10000)
trigger1 = anim != 5 + Var(29)*10000
trigger2 = anim = 5 + Var(29)*10000 && !animtime
value = ifelse(var(40) = 1, 2, 0) + Var(29)*10000

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
trigger2 = Time = 4
x = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050
ctrl = 0

; Stand to Crouch
[StateDef 10]
type = C
physics = C
moveType = I
velSet = 0,0
sprPriority = 0

[State -7, 5] ;Are you floating?
type = ChangeState
triggerall = pos y < 0
trigger1 = time > 1
value = 52

[State 10, ChangeAnim]
type = ChangeAnim
trigger1 = !Time && Anim = 12 + Var(29)*10000
value = 10 + Var(29)*10000
elem = 3 - AnimElemNo(0)

[State 10, ChangeAnim]
type = ChangeAnim
trigger1 = Anim != 10 + Var(29)*10000
value = 10 + Var(29)*10000

[State 10, End]
type = ChangeState
trigger1 = !AnimTime
value = 11

; Crouching
[StateDef 11]
type = C
physics = C
moveType = I
anim = 11 + Var(29)*10000
velSet = 0,0
sprPriority = 0

[State 11, ChangeAnim]
type = ChangeAnim
trigger1 = Anim = 6 + Var(29)*10000 && !AnimTime
value = 11 + Var(29)*10000

;Crouch to Stand
[StateDef 12]
type = S
physics = S
moveType = I
velSet = 0,0
sprPriority = 0

[State 12, ChangeAnim]
type = ChangeAnim
trigger1 = !Time && Anim = 10 + Var(29)*10000
value = 12 + Var(29)*10000
elem = 3 - AnimElemNo(0)

[State 12, ChangeAnim]
type = ChangeAnim
trigger1 = Anim != 12 + Var(29)*10000
value = 12 + Var(29)*10000

[State 12, End]
type = ChangeState
trigger1 = command = "holddown" && command != "holdup"
value = 10

[State 12, End]
type = ChangeState
trigger1 = !AnimTime
value = 0

; Crouching(CPU)
[Statedef 16]
type    = C
physics = C
anim = 11 + Var(29)*10000
sprpriority = 0
ctrl = 0

[State -7, 5] ;Are you floating?
type = ChangeState
triggerall = pos y < 0
trigger1 = time > 1
value = 52

[State 11, 1]
type = Turn
trigger1 = P2dist X < 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

;---------------------------------------------------------------------------
;Walk
[StateDef 20]
type = S
physics = S
moveType = I
sprPriority = 0

[State -7, 5] ;Are you floating?
type = ChangeState
triggerall = pos y < 0
trigger1 = time > 1
value = 52

[State 20, VelSet]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, VelSet]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, ChangeAnim]
type = ChangeAnim
triggerAll = vel x > 0
trigger1 = Anim != 20 + Var(29)*10000 && Anim != 5 + Var(29)*10000
trigger2 = Anim = 5 + Var(29)*10000 && AnimElemTime(1) >= 1
value = 20 + Var(29)*10000

[State 20, ChangeAnim]
type = ChangeAnim
triggerAll = vel x < 0
trigger1 = Anim != 21 + Var(29)*10000 && Anim != 5 + Var(29)*10000
trigger2 = Anim = 5 + Var(29)*10000 && AnimElemTime(1) >= 1
value = 21 + Var(29)*10000

;---------------------------------------------------------------------------
;Walk CPU
[Statedef 21]
type    = S
physics = N
sprpriority = 0
ctrl = 0
velset = 0,0

[State -7, 5] ;Are you floating?
type = ChangeState
triggerall = pos y < 0
trigger1 = time > 1
value = 52

[State 20, 1]
type = Turn
trigger1 = P2dist X < 0

[State 20, 1]
type = VelSet
trigger1 = time = 0
x = const(velocity.walk.fwd.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20
value = 20 + Var(29)*10000

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21
value = 21 + Var(29)*10000

[State 20, 4]
type = changestate
trigger1 = time > 20
trigger1 = P2bodydist x <= 50 && anim = 20
trigger2 = time > 20
trigger2 = P2bodydist x >= 120 && anim = 21
trigger3 = inguarddist
trigger4 = roundstate != 2
value = 0
ctrl = 1
;---------------------------------------------------------------------------
;Walk CPU
[Statedef 22]
type    = S
physics = N
sprpriority = 0
ctrl = 0
velset = 0,0

[State -7, 5] ;Are you floating?
type = ChangeState
triggerall = pos y < 0
trigger1 = time > 1
value = 52

[State 20, 1]
type = Turn
trigger1 = P2dist X < 0

[State 20, 1]
type = VelSet
trigger1 = time = 0
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20
value = 20 + Var(29)*10000

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21
value = 21 + Var(29)*10000

[State 20, 4]
type = changestate
trigger1 = time > 20
trigger1 = P2bodydist x <= 50 && anim = 20
trigger2 = time > 20
trigger2 = P2bodydist x >= 120 && anim = 21
trigger3 = inguarddist
trigger4 = roundstate != 2
value = 0
ctrl = 1
;===========================================================================
; Jumping
;===========================================================================
[Statedef 40]
type    = S
physics = S
anim = 40 + Var(29)*10000
ctrl = 0
sprpriority = 1
facep2 = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
;Jump (CPU)
[Statedef 42]
type    = S
physics = S
anim = ifelse((!var(20) || var(20) = 1),(40 + Var(29)*10000),(50 + Var(29)*10000))
ctrl = 0
velset = 0,0

[State 42, HitBy]
type = HitBy
trigger1 = 1
value = SCA, NA,SA,HA,NP,SP,HP

[State 40, 4]
type = VarSet
trigger1 = Time = 0
var(4) = 0

[State 40, 4]
type = VarSet
trigger1 = Time = 0
var(3) = 0

[State 42, 3]
type = VelSet
trigger1 = AnimTime = 0
x = const(velocity.jump.fwd.x)
y = const(velocity.jump.y)

[State 42, Effect]
type = PlaySnd
trigger1 = AnimTime = 0
value = 40, 0
channel = 20

[State 42, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1
