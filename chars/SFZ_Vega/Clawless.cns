;---------------------------------------------------------------------------
; HITA_FALL (knocked up, falling)
[Statedef 5050]
type    = A
movetype= H
physics = N

[State -2, 3] 
type = ChangeState
triggerall = !alive
trigger1 = prevstateno = 132 || prevstateno = 120
value = 5960

[State 5050, 1] ;Change anim when done with transition
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = Anim = 5035 + Var(29)*10000
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 5035 + Var(29)*10000
trigger2 = (Anim != [5051, 5059]) && (Anim != [5061, 5069]) || (Anim != [15051, 15059]) && (Anim != [15061, 15069])
trigger2 = Anim != 5090 + Var(29)*10000 ;Not if hit off ground anim
value = 5050 + Var(29)*10000

[State 5050, 2] ;Coming down anim
type = ChangeAnim
trigger1 = anim = [5050,5059] || anim = [15050,15059]
trigger1 = Vel Y >= ifelse(anim = (5050 + Var(29)*10000), 1, -2)
trigger1 = SelfAnimExist(anim+10)
value = anim+10
persistent = 0

[State 5050, 3] ;Gravity
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5050, 4] ;Recover near ground
type = ChangeState
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 5200 ;HITFALL_RECOVER

[State 5050, 6]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = (Pos Y >= ifelse((anim = [5051,5059]) || (anim = [5061,5069]), 0, 25)) || (Pos Y >= ifelse((anim = [15051,15059]) || (anim = [15061,15069]), 0, 25))
value = 5100 ;HIT_BOUNCE

