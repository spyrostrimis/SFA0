yscale = 1
ground.back = 25
ground.front = 25
air.back = 25
air.front = 35
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -80
mid.pos = -5, -50
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 3.1
walk.back = -2.3
run.fwd  = 3.5, 0
run.back = -4.5,-3.8
jump.neu = 0,-9.2
jump.back = -3
jump.fwd = 2.5
runjump.back = -2.55,-8.1
runjump.fwd = 4,-8.1
airjump.neu = 0,-8.1
airjump.back = -2.55
airjump.fwd = 2.5

[Movement]
