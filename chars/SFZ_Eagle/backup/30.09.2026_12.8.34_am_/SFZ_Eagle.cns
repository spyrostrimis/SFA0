; Viendo pajaritos
;-----Dizzy Counter-----
[State -2, Hits]
type = VarAdd
triggerall = UniqHitCount <= 1
triggerall = GetHitVar(hitcount) <= 6
triggerall = StateNo >= 5000
trigger1 = MoveType = H
trigger1 = !HitShakeOver
trigger1 = Time = 0
ignorhitpause = 1
v = 15
value = 1

[State -2, Hit Subtract]
