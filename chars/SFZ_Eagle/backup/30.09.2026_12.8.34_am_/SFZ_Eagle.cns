;---------------------------------------------------------------------------
; EAGLE'S ENDING - one held frame, F15560.
;
; There is no ending art in SFZ_Eagle.sff: sprite groups 7000 (the pictures and
; the old pre-rendered text) was absent, so
; the Blair/Eagle explods this state used to spawn drew nothing at all for 2760
; ticks. F15560 in data/fightfx.air - a single frame on a -1 hold, already
; labelled "; Eagle" there - is the whole picture now, and it stays up for the
; length of the ending.
;
; Nothing animates, so this state carries NO page-cue block and Eagle's entry in
; data/endings/ending_texts.lua declares no cue channels. If he ever gets an
; animated layer, copy the "PAGE CUES" block out of SFZ_Mike.cns and give the
; layer its own explod ID of 10000 + k.
;---------------------------------------------------------------------------

; Winpose Finish Starter
[State 181, 4]
type = AssertSpecial
triggerall = Matchover
trigger1 = Map(sfaz_end_active) = 0 && time = [0,2760]
trigger2 = Map(sfaz_end_active) != 0
flag = roundnotover

; BGMS
[State 181, 7]; Stop Music
type = AssertSpecial
trigger1 = Matchover && time > 1
flag = NoMusic

; Eagle's ending track, added to data/common.snd as 1000,34 (50.4s).
; The previous value here was F9999,1, which does not exist: group 9999 of
; common.snd holds only 2 and 3, so the ending played in silence.
; 1000,35 is reserved for Ingrid - do not take it.
[State 181, 17]; Ending Music
type = PlaySnd
trigger1 = time = 1
value = F1000,34
channel = 7

; --- THE PICTURE ----------------------------------------------------------
; One frame, held, on both paths. It never changes, so there is nothing for the
; mod to cue and no reason to spawn a different explod when it is driving.
; sprpriority 3 is where every other ending backdrop in this roster sits.
[State 181, Ending backdrop]
type = Explod
trigger1 = time = 1 && MatchOver
anim = F15560
ID = 10001
pos = 0,0
postype = left
sprpriority = 3
ownpal = 1
removetime = 999999

; --- THE FRAME ------------------------------------------------------------
; 5 on the original path, 7 when the mod is driving - the same relationship the
; converted characters use, so the frame reads over the picture either way.
[State 181, Franjas de ending]
type = Explod
trigger1 = time = 1 && MatchOver && Map(sfaz_end_active) = 0
anim = F10099
ID = 10000
pos = 0,0
postype = left
sprpriority = 5
ownpal = 1
removetime = 999999
[State 181, Franjas de ending - raised for the transition]
type = Explod
trigger1 = time = 1 && MatchOver && Map(sfaz_end_active) != 0
anim = F10099
ID = 10000
pos = 0,0
postype = left
sprpriority = 7
ownpal = 1
removetime = 999999

;---------------------------------------------------------------------
; ENDING SPEAKER PORTRAIT
;
; Only runs while the mod is driving (Map(sfaz_end_active) != 0). Eagle has no
; original sprite text to carry a face baked in, so on the fallback path there
; is simply no portrait - nothing here fires.
;
; sfaz_end_face is the ELEMENT inside [Begin Action 7050], 1-based, or 0 on a
; page with no portrait. Eagle's art sits at sprite 7050,1 rather than 7050,0,
; so element 1 of that action is 7050,1 - see SFZ_Eagle_final.air.
;
; pos carries ONLY the tunable offset; the SPRITE AXIS (-51,-171) does the
; positioning, the same way every other explod in this ending sits at pos = 0,0.
;
; animelem, not anim: ModifyExplod's anim parameter is gated on the character
; declaring an ikemenversion and this one does not, so anim would silently do
; nothing.
;
; sprpriority 8 clears the F10099 frame, which this state raises to 7 on the
; driven path.
;---------------------------------------------------------------------
[State 181, ending portrait]
type = Explod
trigger1 = MatchOver && Map(sfaz_end_active) != 0
trigger1 = Map(sfaz_end_face) > 0 && NumExplod(10050) = 0
anim = 7050
ID = 10050
pos = Map(sfaz_end_face_x), Map(sfaz_end_face_y)
postype = left
sprpriority = 8
ownpal = 1
removetime = 999999

[State 181, ending portrait - cue]
type = ModifyExplod
trigger1 = NumExplod(10050) && Map(sfaz_end_face) > 0
ID = 10050
animelem = Map(sfaz_end_face)
pos = Map(sfaz_end_face_x), Map(sfaz_end_face_y)
postype = left

[State 181, ending portrait - off]
type = RemoveExplod
trigger1 = NumExplod(10050) && Map(sfaz_end_face) = 0
ID = 10050

[State 181, 16]; Esencial para que esto funcione
type = AssertSpecial
trigger1 = MatchOver = 1 && time >= 0
flag = nobardisplay
flag2 = noFG
flag3 = invisible

; --- LEAVING --------------------------------------------------------------
; Original path: the old fixed clock, untouched, so a missing mod or a missing
; data file still runs for exactly as long as it used to.
[State 181, 8]; Fondo negro
type = Explod
trigger1 = time = 2755 && MatchOver && Map(sfaz_end_active) = 0
anim = F9999
pos = 0,0
postype = left
sprpriority = 9
ownpal = 1
removetime = 999999

[State 162, 9]
type = changestate
trigger1 = Time = 2760 && Map(sfaz_end_active) = 0
value = 18801

; Driven path: there is no such tick - the ending leaves for the outro the
; moment the last page is dismissed.
[State 162, 9 - ending text finished]
type = changestate
trigger1 = Map(sfaz_end_active) != 0 && Map(sfaz_end_done) != 0
value = 18802

; --- THE ENDING IS NOT SKIPPABLE BY A BUTTON ------------------------------
; Every press that turns a page would otherwise also set winskipped, and
; winskipped overrides roundnotover - the round would fade out mid-ending.
; Asserted only on the driven path; the fallback behaves as it always did.
[State 181, Ending not skippable]
type = AssertSpecial
triggerall = MatchOver
trigger1 = Map(sfaz_end_active) != 0
flag = RoundNotSkip

;---------------------------------------------------------------------------
; Ending outro. Only reached on the mod-driven path. A separate state rather
; than more latches in 18800, because entering one resets time to 0 - which
; gives the fade and the hand-over an honest clock again. Mirrors the last few
; ticks of the original tail.
[Statedef 18802]
type = S
physics = S
ctrl = 0
anim = 0
velset = 0,0

[State 181, 4]
type = AssertSpecial
triggerall = Matchover
trigger1 = 1
flag = roundnotover

; The press that dismissed the last page is still in the buffer when this state
; begins; without this it would set winskipped here instead.
[State 181, 4b]
type = AssertSpecial
triggerall = Matchover
trigger1 = 1
flag = RoundNotSkip

[State 181, 7]; Stop Music
type = AssertSpecial
trigger1 = Matchover
flag = NoMusic

[State 181, 16]; Remove elements
type = AssertSpecial
trigger1 = MatchOver = 1
flag = nobardisplay
flag2 = noFG
flag3 = invisible

[State 181, 8]; Stage
type = Explod
trigger1 = time = 5 && MatchOver
anim = F9999
pos = 0,0
postype = left
sprpriority = 9
ownpal = 1
removetime = 999999

[State 162, 9]
type = changestate
trigger1 = Time = 10
value = 18801

[Statedef 18801];Arcade terminado
type = S
physics = S
ctrl = 0
anim = 0
velset = 0,0

; Winpose Finish Starter
; roundnotover deliberately NOT asserted. It existed to hold the round open
; while the podium played; with the podium gone it only produced a black
; hold (noBG) during which the KO'd opponent was still on screen -- P1 can
; assert 'invisible' for itself but not for P2. Letting the round end at
; once hands straight over to the engine's [Win Screen].

[State 1100, 1]
type = RemoveExplod
trigger1 = time = 0
ID = 10000
; The ending backdrop is its own ID, so it needs its own removal.
[State 1100, 2]
type = RemoveExplod
trigger1 = time = 0
ID = 10001

; BGMS
[State 181, 7]; Stop Music
type = AssertSpecial
trigger1 = Matchover   ; was "time > 1" -- the state no longer lives that long
flag = NoMusic
[State 181, 17]; End Music
type = PlaySnd
triggerall = MatchOver
trigger1 = time = 1
value = F9999,0

; --- Ehnyd's podium / award-ceremony Explods removed -----------------------
; Stage (F10001+random%2), Podium (F10011), Chara (anim 182), Premiado
; (F10020+random%4) and his own ALL CLEAR (F10000) used to spawn here on
; MatchOver, all with removetime = 999999. They duplicated the screenpack's
; real [Win Screen] (data/system.def) and showed a yellow backdrop with Eagle
; posing before it. The state is kept: it still clears the ending backdrop
; (RemoveExplod 10000/10001) and stops the music.
; ---------------------------------------------------------------------------

[State 181, 16]; Esencial para que esto funcione
type = AssertSpecial
trigger1 = MatchOver = 1 && time >= 0
flag = nobardisplay
flag2 = noFG
flag3 = invisible

; The stage was still drawing in the gap between the ending and the engine's
; [Win Screen]. AssertSpecial takes only three flags, so noBG needs its own
; block. Engine: FillRect(scrrect, nobg ? black : stage.bgclearcolor) then
; 'if !nobg { stage.draw() }' -- this replaces the stage with a flat fill so
; it cannot flash between the two screens.
[State 18801, Hide stage]
type = AssertSpecial
trigger1 = MatchOver = 1 && time >= 0
flag = noBG

