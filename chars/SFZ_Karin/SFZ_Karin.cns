;===========================================================================
; Archivo Air para Karin Kanzuki            
;===========================================================================
; Standing Actions
;===========================================================================
[Data]
life = 1000
power = 3000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 43
airjuggle = 15
sparkno = ifelse(teamside = 1,7,50007)
guard.sparkno = ifelse(teamside = 1,1,50001)
KO.echo = 1
volume = 255
IntPersistIndex = 30
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 23
ground.front = 21
air.back = 12
air.front = 18
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -6, -68
mid.pos = -5, -30
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 3.2
walk.back = -3
run.fwd  = 5, 0
run.back = -4.5,-3.8
jump.neu = 0,-8.4
jump.back = -2.60
jump.fwd = 2.63
runjump.back = -2.55,-8.1
runjump.fwd = 4,-8.1
airjump.neu = 0,-8.1
airjump.back = -2.55
airjump.fwd = 2.5

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .44
stand.friction = .85
crouch.friction = .82

;===========================================================================
; Run
;===========================================================================
[Statedef 100]
type=S
physics=N
movetype=I
anim=100
ctrl=0
sprpriority=1

[State 100, 1]
type = PlaySND
trigger1 = Time = 0
value = S100,0

[State 102, Type]
type=statetypeset
trigger1= animelemtime(1)>=0
statetype=S
physics=N

[State 102, Vel]
type=velset
trigger1= animelem=2
x= 7.738

[State 102, Vel]
type=velset
trigger1= animelem=6
x= 0

[State 102, End]
type=changestate
trigger1= Animtime= 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Paso hacia atras
[Statedef 105]
type    = S
physics = N
ctrl = 0
anim = 105
sprpriority = 1

[State 100, 1]
type = PlaySND
trigger1 = Time = 0
value = S100,0

[State 105, 1]
type = StateTypeSet
trigger1 = AnimElem = 3
StateType = A

[STate 1]
type = Velset
trigger1 = Time = 2
x = -8
y = -3

[state a]
type = veladd
trigger1 = animelem = 3,>0
y = 0.9

[state a]
type = velmul
trigger1 = 1
x = 0.95

[State 105, 3]
type = ChangeState
trigger1 = Pos Y >= 0 && Vel Y > 0
value = 106

