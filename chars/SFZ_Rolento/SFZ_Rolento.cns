;===========================================================================
; Data Principal
;===========================================================================
[Data]
life = 1000
power = 3000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 43
airjuggle = 15
sparkno = ifelse(teamside = 1,7,50007)
guard.sparkno = ifelse(teamside = 1,1,50001)
KO.echo = 1
volume = 5
IntPersistIndex = 30
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 18
ground.front = 20
air.back = 13
air.front = 20
z.width = 3
height = 60
attack.width = 4,4
attack.dist = 250
proj.attack.dist = 90
proj.doscale = 0
head.pos = -12, -82
mid.pos = -19, -60
shadowoffset = 0

[Velocity]
walk.fwd  = 4.4
walk.back = -3.25
jump.neu = 0,-8.7
jump.back = -4.7, -8.7
jump.fwd = 3.95
runjump.back = -2.55,-8.1
runjump.fwd = 3.4,-8.1
airjump.neu = 0,-8.1
airjump.back = -2.55,-8.1
airjump.fwd = 2.5,-8.1

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .55
stand.friction = .84
crouch.friction = .84

;===========================================================================
; Run
;===========================================================================
; Dash adelante
[Statedef 102]
type=S
physics=N
movetype=I
anim=101
ctrl=0
sprpriority=1

[State 100, 1]
type = PlaySND
trigger1 = AnimElem = 2
value = F100,0;S0,5

[State 100, 1]
type = PlaySND
trigger1 = AnimElem = 5
value = S0,0

[State 102, Type]
type=statetypeset
trigger1= animelemtime(1)>=0
statetype=S
physics=N

[State 102, Vel]
type=velset
trigger1= animelem=2
x= 7.738

[State 102, Vel]
type=velset
trigger1= animelem=5
x= 0

[State 102, End]
type=changestate
trigger1= Animtime= 0
value = 0
ctrl = 1

