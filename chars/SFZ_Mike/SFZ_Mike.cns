;===========================================================================
; Archivo Air para Mike Bison / Balrog      
;===========================================================================
; Main Data
;===========================================================================
[Data]
life = 1000
power = 3000
attack = 95
defence = 100
fall.defence_up = 50
liedown.time = 43
airjuggle = 15
sparkno = ifelse(teamside = 1,7,50007)
guard.sparkno = ifelse(teamside = 1,1,50001)
KO.echo = 1
volume = 255
IntPersistIndex = 30
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 20
ground.front = 30
air.back = 12
air.front = 12
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = 19, -90
mid.pos = 2, -61

[Velocity]
walk.fwd  = 3.8
walk.back = -3.5
run.fwd  = 6,-3
run.back = -6,-3
jump.neu = 0,-9.2
jump.back = -3
jump.fwd = 2.5
runjump.back = -2.55,-8.1
runjump.fwd = 4,-8.1
airjump.neu = 0,-8.1
airjump.back = -2.55
airjump.fwd = 2.5

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .45
stand.friction = .85
crouch.friction = .82

;===========================================================================
; Run
;===========================================================================
; Forward
[Statedef 100]
type    = A
physics = N
ctrl = 0
anim = 100
sprpriority = 1

[State 100, 1]
type = VelSet
trigger1 = AnimElem=2
x = const(velocity.run.fwd.x)
y = const(velocity.run.fwd.y)

[State 150, step]
type = PlaySnd
trigger1 = time = 0
value = F100,0

[state 100, 2]
type = gravity
trigger1 = time >= 5

[state 100, 3]
type = veladd
trigger1 = time >= 5
x = -0.05

[State 100, 5]
type = ChangeState
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 101

; Aterrizaje
[Statedef 101]
type    = S
physics = S
ctrl = 0
anim = 101

[State 150, step]
type = PlaySnd
trigger1 = time = 0
value = F52,0

[State 106, 1]
type = VelSet
trigger1 = Time = 0
y = 0
x = 0

[State 106, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 106, 4]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

; Back
[Statedef 105]
type    = A
physics = N
ctrl = 0
anim = 105
sprpriority = 1

[State 105, 1]
type = VelSet
trigger1 = AnimElem=2
x = const(velocity.run.back.x)
y = const(velocity.run.back.y)

[State 150, step]
type = PlaySnd
trigger1 = time = 0
value = F100,0

[state 105, 2]
type = veladd
trigger1 = time >= 5
x = 0.05

[state 105, 3]
type = gravity
trigger1 = time >= 5

[State 105, 4]
type = ChangeState
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 106

; Aterrizaje
[Statedef 106]
type    = S
physics = S
ctrl = 0
anim = 106

[State 150, step]
type = PlaySnd
trigger1 = time = 0
value = F52,0

[State 106, 1]
type = VelSet
trigger1 = Time = 0
y = 0
x = 0

[State 106, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 106, 4]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1


;===========================================================================
; TIME OVER
;===========================================================================
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, Sound]
type = PlaySnd
trigger1 = Time = 0
value = S5300,0

[State 170, NotHitBy]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

;===========================================================================
; Winner Pos
;===========================================================================
[Statedef 180]
type = S

[State 181, Perfect msg]
type = Explod
triggerall = WinPerfect
trigger1 = (IsHomeTeam = 0) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
anim = F180
pos = 0,-5
sound = F180,180
postype = Left
facing = 1
sprpriority = 9
ownpal = 0

[State 181, Perfect Voice]
type = PlaySnd
triggerall = WinPerfect
trigger1 = (IsHomeTeam = 0) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
trigger1 = time = 0
value = F180,180
Loop = 0

[State 181, Win Voice]
type = PlaySnd
triggerall = WinKO = 1
trigger1 = (IsHomeTeam = 0) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
value = F3,1
Loop = 0

[State 181, Lose Voice]
type = PlaySnd
triggerall = WinKO = 1
trigger1 = (IsHomeTeam = 1) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
value = F3,2
Loop = 0

[State 180, 2]; Boss Battle
type = ChangeState
trigger1 = Time = 0
trigger1 = var(44) = 1
trigger1 = matchover
value = 189
[State 180, 2]; Shin Akuma
type = ChangeState
trigger1 = Time = 0
trigger1 = var(43) = 1
trigger1 = matchover
value = 188

[State 180, 1]
type = VarRandom
trigger1 = 1
v = 1
range = 1,6

[State 180, 2] ;Choose win 1
type = VarSet
trigger1 = Command = "hold_x"
v = 1
value = 1

[State 180, 3] ;Choose win 2
type = VarSet
trigger1 = Command = "hold_a"
v = 1
value = 2

[State 180, 4] ;Choose win 3
type = VarSet
trigger1 = Command = "hold_y"
v = 1
value = 3

[State 180, 4] ;Choose win 4
type = VarSet
trigger1 = Command = "hold_b"
v = 1
value = 4

[State 180, 4] ;Choose win 5
type = VarSet
trigger1 = Command = "hold_z"
v = 1
value = 5

[State 180, 4] ;Choose win 6
type = VarSet
trigger1 = Command = "hold_c"
v = 1
value = 6

[State 180, 2]
type = ChangeState
trigger1 = Var(1) = 1
value = 181

[State 180, 3]
type = ChangeState
trigger1 = Var(1) = 2
value = 182

[State 180, 4]
type = ChangeState
trigger1 = var(1) = 3
value = 183

[State 180, 4]
type = ChangeState
trigger1 = var(1) = 4
value = 184

[State 180, 4]
type = ChangeState
trigger1 = var(1) = 5
value = 185

[State 180, 4]
type = ChangeState
trigger1 = var(1) = 6
value = 186

; Win 1: la de SF2 (1)
[Statedef 181]
type = S
movetype = I
physics = S
anim = 181
velset = 0, 0
ctrl = 0

[State 1100, 1]
type = RemoveExplod
trigger1 = time = 0
ID = 6000
[State 1100, 1]
type = RemoveExplod
trigger1 = time = 0
ID = 6010

[State 4200, PlaySnd]
type = PlaySnd
trigger1 = Time = 0
value = 191,0

[State 181, Win conditions]
type = AssertSpecial
triggerall = (GameMode = "arcade") && (Teammode = Single)
trigger1 = time = [0,250]
flag = roundnotover

[State 181, Win conditions]
type = AssertSpecial
triggerall = (GameMode = "arcade") && (Teammode = Single)
trigger1 = time = [0,300]
flag = RoundNotSkip

[State 181, Win conditions]
type = AssertSpecial
triggerall = (GameMode = "arcade" && Teammode != single) || GameMode != "arcade"
trigger1 = time = [0,200]
flag = RoundNotSkip

; Winpose Finish Starter
[State 181, 4]
type = AssertSpecial
triggerall = Matchover
trigger1 = time = [220,710]
flag = roundnotover


[State 181, 8]; Winquote background (Data)
type = Explod
triggerall = (GameMode = "arcade") && (Teammode = Single)
trigger1 = time = 220 && MatchOver
anim = F9001
pos = 0,0
postype = left
sprpriority = 7
ownpal = 1
removetime = 999999

[State 181, 8]; Anim SFZ (Data)
type = Explod
triggerall = (GameMode = "arcade") && (Teammode = Single)
trigger1 = time = 220 && MatchOver
anim = F9002
pos = 0,0
postype = left
sprpriority = 9
ownpal = 1
removetime = 999999

[State 181, 8]; Random Winquote (Data)
type =  Explod
triggerall = (GameMode = "arcade") && (Teammode = Single)
trigger1 = time = 220 && MatchOver
anim = F9005+(random%3)
pos = 0,0
postype = left
sprpriority = 9
ownpal = 1
removetime = 999999

[State 181, 8]; Winner (Chara)
type =  Explod
triggerall = (GameMode = "arcade") && (Teammode = Single)
trigger1 = time = 220 && MatchOver
anim = 9001
pos = 0,0
postype = left
sprpriority = 9
ownpal = 1
removetime = 999999

[State 181, 8]; Portrait (Chara)
type = Explod
triggerall = (GameMode = "arcade") && (Teammode = Single)
trigger1 = time = 230 && MatchOver
anim = 9500
pos = 0,0
postype = left
sprpriority = 8
ownpal = 1
removetime = 999999

[State 181, 16]; Remove elements
type = AssertSpecial
triggerall = (GameMode = "arcade") && (Teammode = Single)
trigger1 = MatchOver = 1 && time >= 220 && Teammode != Simul
flag = nobardisplay
flag2 = noFG
flag3 = invisible

