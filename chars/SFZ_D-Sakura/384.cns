;===========================================================================
; Data principal
;===========================================================================
[Data]
life = 1000
power = 3000
attack = 100
defence = 98
fall.defence_up = 50
liedown.time = 43
airjuggle = 15
sparkno = ifelse(teamside = 1,7,50007)
guard.sparkno = ifelse(teamside = 1,1,50001)
KO.echo = 1
volume = 255
IntPersistIndex = 30
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 20
ground.front = 18
air.back = 12
air.front = 12
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -75
mid.pos = -5, -40
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 3.0
walk.back = -2.5
jump.neu = 0,-9.2
jump.back = -3.0
jump.fwd = 2.8

[Movement]
airjump.num = 0
airjump.height = 28
yaccel = .4
stand.friction = .85
crouch.friction = .82

;===========================================================================
; Winner States
;===========================================================================
[Statedef 180]
type = S

[State 181, Perfect msg]
type = Explod
triggerall = WinPerfect
trigger1 = (IsHomeTeam = 0) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
anim = F180
pos = 0,-5
sound = F180,180
postype = Left
facing = 1
sprpriority = 9
ownpal = 0

[State 181, Perfect Voice]
type = PlaySnd
triggerall = WinPerfect
trigger1 = (IsHomeTeam = 0) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
trigger1 = time = 0
value = F180,180
Loop = 0

[State 181, Win Voice]
type = PlaySnd
triggerall = WinKO = 1
trigger1 = (IsHomeTeam = 0) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
value = F3,1
Loop = 0

[State 181, Lose Voice]
type = PlaySnd
triggerall = WinKO = 1
trigger1 = (IsHomeTeam = 1) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
value = F3,2
Loop = 0

[State 180, 2]; Boss Battle
type = ChangeState
trigger1 = Time = 0
trigger1 = var(44) = 1
trigger1 = matchover
value = 189
[State 180, 2]; Shin Akuma
type = ChangeState
trigger1 = Time = 0
trigger1 = var(43) = 1
trigger1 = matchover
value = 188

[State 180, 1]
type = VarRandom
trigger1 = 1
v = 10
range = 1,7

[State 180, 2] ;Choose win 1
type = VarSet
trigger1 = Command = "hold_x"
v = 10
value = 1

[State 180, 3] ;Choose win 2
type = VarSet
trigger1 = Command = "hold_a"
v = 10
value = 2

[State 180, 4] ;Choose win 3
type = VarSet
trigger1 = Command = "hold_y"
v = 10
value = 3

[State 180, 4] ;Choose win 4
type = VarSet
trigger1 = Command = "hold_b"
v = 10
value = 4

[State 180, 4] ;Choose win 5
type = VarSet
trigger1 = Command = "hold_z"
v = 10
value = 5

[State 180, 4] ;Choose win 6
type = VarSet
trigger1 = Command = "hold_c"
v = 10
value = 6

[State 180, 4] ;Choose win 6
type = VarSet
trigger1 = Command = "hold_s"
v = 10
value = 7

[State 180, 2]
type = ChangeState
trigger1 = Var(10) = 1
value = 181

[State 180, 3]
