trigger1 = time = 0
ID = 6000
[State 1100, 1]
type = RemoveExplod
trigger1 = time = 0
ID = 6010
[State 1100, 1]
type = RemoveExplod
trigger1 = time = 0
ID = 6020

[State 181, Win conditions]
type = AssertSpecial
triggerall = (GameMode = "arcade") && (Teammode = Single)
trigger1 = time = [0,250]
flag = roundnotover

[State 181, Win conditions]
type = AssertSpecial
triggerall = (GameMode = "arcade") && (Teammode = Single)
trigger1 = time = [0,300]
flag = RoundNotSkip

[State 181, Win conditions]
type = AssertSpecial
triggerall = (GameMode = "arcade" && Teammode != single) || GameMode != "arcade"
