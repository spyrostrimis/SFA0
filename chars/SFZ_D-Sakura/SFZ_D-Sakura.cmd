value = 4050
triggerall = !var(59)
triggerall = command = "Super2_S"
triggerall = (numproj = 0) && (power >= 3000)
trigger1 = statetype = A 
trigger1 = stateno != [600,699] 
trigger1 = stateno != [1000,4999]
trigger1 = ctrl 
trigger2 = (stateno = 600) && movecontact
