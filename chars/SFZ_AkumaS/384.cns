;===========================================================================
; Main Data
;===========================================================================
[Data]
life = 1000
power = 3000
attack = 115
defence = 115
fall.defence_up = 50
liedown.time = 43
airjuggle = 15
sparkno = ifelse(teamside = 1,7,50007)
guard.sparkno = ifelse(teamside = 1,1,50001)
KO.echo = 1
volume = 255
IntPersistIndex = 30
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 20
ground.front = 20
air.back = 18
air.front = 18
z.width = 110
height = 50
attack.width = 4,4
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = 7,-78
mid.pos = -1,-47
shadowoffset = 0

[Velocity]
walk.fwd  = 3.0
walk.back = -2.0
run.fwd  = 5.50, 0
run.back = -4.80, 0
jump.neu = 0,-9.2
jump.fwd = 3.00
jump.back = -3.50

[Movement]
airjump.num = 0
;airjump.height = 35
yaccel = .43
stand.friction = .85
crouch.friction = .82

;===========================================================================
; Run
;===========================================================================
; Forward
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1

[State 100, 1]
type = VelSet
trigger1 = 1
x = 8;const(velocity.run.fwd.x)

[State 100, 2]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = Time = 10
value = 10

;---------------------------------------------------------------------------
[Statedef 105]
type    = S
physics = S
anim = 105
sprpriority = 1

[State 100, 1]
type = VelSet
trigger1 = 1
x = -8;const(velocity.run.fwd.x)

[State 100, 2]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = Time = 10
value = 10

;===========================================================================
; TIME OVER
;===========================================================================
[Statedef 170]
type = S
ctrl = 0
anim = 175
velset = 0,0

[State 170,1]
type = NotHitBy
trigger1 = 1
value = SCA

[State 170,12]
type = AssertSpecial
trigger1 = Time = [0,80]
flag = RoundNotOver

[Statedef 175]
type = S
ctrl = 0
velset = 0,0

[State 175,0]
type = ChangeState
trigger1 = Time = 0
value = 170

;===========================================================================
; Winner Pos
;===========================================================================
[Statedef 180]
type = S

[State 181, Perfect msg]
type = Explod
triggerall = WinPerfect
trigger1 = (IsHomeTeam = 0) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
anim = F180
pos = 0,-5
sound = F180,180
postype = Left
facing = 1
sprpriority = 9
ownpal = 0

[State 181, Perfect Voice]
type = PlaySnd
triggerall = WinPerfect
trigger1 = (IsHomeTeam = 0) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
trigger1 = time = 0
value = F180,180
Loop = 0

[State 181, Win Voice]
type = PlaySnd
triggerall = WinKO = 1
trigger1 = (IsHomeTeam = 0) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
value = F3,1
Loop = 0

[State 181, Lose Voice]
type = PlaySnd
triggerall = WinKO = 1
trigger1 = (IsHomeTeam = 1) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
value = F3,2
Loop = 0

[State 180, 2]; Boss Battle
type = ChangeState
trigger1 = Time = 0
trigger1 = var(44) = 1
trigger1 = matchover
value = 189
[State 180, 2]; Shin Akuma
type = ChangeState
trigger1 = Time = 0
trigger1 = var(43) = 1
trigger1 = matchover
value = 188

[State 180, 1]
type = VarRandom
trigger1 = 1
v = 10
range = 1,6

[State 180, 2] ;Choose win 1
type = VarSet
trigger1 = Command = "xx"
v = 10
value = 1

[State 180, 3] ;Choose win 2
type = VarSet
trigger1 = Command = "aa"
v = 10
value = 2

[State 180, 4] ;Choose win 3
type = VarSet
trigger1 = Command = "yy"
v = 10
value = 3

[State 180, 4] ;Choose win 4
type = VarSet
trigger1 = Command = "bb"
v = 10
value = 4

[State 180, 4] ;Choose win 5
type = VarSet
trigger1 = Command = "zz"
v = 10
value = 5

[State 180, 4] ;Choose win 6
type = VarSet
trigger1 = Command = "cc"
v = 10
value = 6

[State 180, 2]
type = ChangeState
trigger1 = Var(10) = 1
value = 181

[State 180, 3]
type = ChangeState
trigger1 = Var(10) = 2
value = 182

[State 180, 4]
type = ChangeState
trigger1 = var(10) = 3
value = 183

[State 180, 4]
type = ChangeState
trigger1 = var(10) = 4
value = 184

[State 180, 4]
type = ChangeState
trigger1 = var(10) = 5
value = 185

[State 180, 4]
type = ChangeState
trigger1 = var(10) = 6
value = 186

; Win 1: Pose d combate
