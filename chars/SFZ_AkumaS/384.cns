trigger1 = time = 0
ID = 6021

[State 1100, 1]
type = RemoveExplod
trigger1 = time = 0
ID = 6030

[State 181, Win conditions]
type = AssertSpecial
triggerall = (GameMode = "arcade") && (Teammode = Single)
trigger1 = time = [0,250]
flag = roundnotover

[State 181, Win conditions]
type = AssertSpecial
triggerall = (GameMode = "arcade") && (Teammode = Single)
trigger1 = time = [0,300]
flag = RoundNotSkip

[State 181, Win conditions]
type = AssertSpecial
triggerall = (GameMode = "arcade" && Teammode != single) || GameMode != "arcade"
trigger1 = time = [0,200]
flag = RoundNotSkip

; Winpose Finish Starter
[State 181, 4]
type = AssertSpecial
triggerall = Matchover
trigger1 = time = [220,710]
flag = roundnotover



[State 181, 8]; Winquote background (Data)
