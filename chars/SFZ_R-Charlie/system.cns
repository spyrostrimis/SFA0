text2 = "<p1>Who are you and what do you want?"
text3 = "<p2>I want -him- gone. And I know what to do."
text4 = "<p2>But before that, I want to see what you got."

[State 191, Dialogue]
type = Dialogue
trigger1 =StageVar(info.name) = "E-Ryu Boss"
trigger1 = matchno = 9 && IsHomeTeam = 0
hidebars = 1
text1 = "<p2>Did Rose send you here?"
text2 = "<p1>Ryu... I need your help to defeat -him-."
text3 = "<p1>Only your power and pure soul can stop this madness."
text4 = "<p2>I will help you."
text5 = "<p2>But first, I need to be sure if that's really you."

