yscale = 1
ground.back = 24
ground.front = 30
air.back = 20
air.front = 20
z.width = 10
height = 50
attack.width = 4,4
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5,-80
mid.pos = -5,-50
shadowoffset = 1

[Velocity]
walk.fwd  = 2.30
walk.back = -1.90
run.fwd  = 4.60, 0
run.back = -4.50, 0
jump.neu = 0,-10.0
jump.fwd = 3.40
jump.back = -3.30
;runjump.back = -2.55,-8.1
;runjump.fwd = 3.6,-9.0
;airjump.neu = 0,-9.3
;airjump.back = -2.55,-8.1
;airjump.fwd = 2.5,-8.1

[Movement]
airjump.num = 0
;airjump.height = 35
yaccel = .5
stand.friction = .85
crouch.friction = .82

