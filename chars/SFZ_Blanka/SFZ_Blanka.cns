;===========================================================================
; Main Data
;===========================================================================
[Data]
life = 1000
power = 3000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 43
airjuggle = 15
sparkno = ifelse(teamside = 1,7,50007)
guard.sparkno = ifelse(teamside = 1,1,50001)
KO.echo = 1
volume = 255
IntPersistIndex = 30
FloatPersistIndex = 40

[Size]
