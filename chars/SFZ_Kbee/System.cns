type=varset
trigger1= !time
fvar(1)= p2dist x

[State 3210, Y]
type=varset
trigger1= !time
fvar(2)= p2dist y

[State 3210, /]
type=varset
trigger1= !time
fvar(3)= (fvar(1)**2 + fvar(2)**2) ** .5

[State 3210, vel]
type=velset
trigger1= !time && !fvar(3)
x= 0
y= ifelse(pos y>=0, -14, 18)

[State 3210, vel]
