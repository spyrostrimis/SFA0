; Helper: Dictador
[Statedef 18201]
type = A
movetype = I
physics = N
anim = 189
velset = 0,0
ctrl = 0

[State 186, 1]
type = VarSet
trigger1 = 1
triggerall = p2name != "Dictador"
fv = 1
value = pi / 60 * (Time - 22)

[State 186,2]
type = PosSet
trigger1 = AnimElem = 6, >= 0
y = -40 - (1 + Sin(FVar(1) - pi / 2)) * 15

[State 7021,DestroySelf]
type = DestroySelf
trigger1 = time = 219 && MatchOver

