movetype = I
physics = S
anim = 191

[State 191, Dialogue]
type = Dialogue
trigger1 =StageVar(info.name) = "Honda Boss"
trigger1 = matchno = 5 && IsHomeTeam = 0
hidebars = 1
text1 = "<p1>E.Honda I have questions for you... about a man..."
text2 = "<p1>Sodom, he challenged you in a wrestling tournament."
text3 = "<p1>I am gathering clues about where he might be."
text4 = "<p2>You might have your answers, boy!"
text5 = "<p2>But before that, let's see if you are worthy."

[State 191, Dialogue]
type = Dialogue
trigger1 =StageVar(info.name) = "Sodom-X Boss"
trigger1 = matchno = 9 && IsHomeTeam = 0
hidebars = 1
text1 = "<p2>What? You again!"
text2 = "<p1>Appears that you missed me."
text3 = "<p2>I will crush your bones."
text4 = "<p1>Well, I see you haven't learned your lesson."

[State 191, Dialogue]
type = Dialogue
trigger1 =StageVar(info.name) = "Rolento Boss2"
trigger1 = matchno = 10 && IsHomeTeam = 0
hidebars = 1
text1 = "<p2>So you defeated the Mad Gear Gang once more..."
text2 = "<p2>But you will submit to me, to your supreme leader!"
text3 = "<p1>It's over, Rolento. Accept your defeat."
text4 = "<p2>Pity! Now I will have to rebuild my empire...ON YOUR FACE!"

