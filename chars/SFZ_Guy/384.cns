;=====================================================================
; Main Data
;=====================================================================
[Data]
life = 1000
power = 3000
attack = 120
defence = 100
fall.defence_up = 50
liedown.time = 43
airjuggle = 15
sparkno = ifelse(teamside = 1,7,50007)
guard.sparkno = ifelse(teamside = 1,1,50001)
KO.echo = 1
volume = 255
IntPersistIndex = 30
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 20
ground.front = 20
air.back = 12
air.front = 12
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -80
mid.pos = -5, -60
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 3.5
walk.back = -2.5
jump.neu = 0,-9.3
jump.back = -4.1
jump.fwd = 4

[Movement]
airjump.num = 0
airjump.height = 28
yaccel = .45
stand.friction = .85
crouch.friction = .82

