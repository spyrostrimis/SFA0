;===========================================================================
; Data principal
;===========================================================================
[Data]
life = 1000
power = 3000
attack = 100
defence = 98
fall.defence_up = 50
liedown.time = 43
airjuggle = 15
sparkno = ifelse(teamside = 1,7,50007)
guard.sparkno = ifelse(teamside = 1,1,50001)
KO.echo = 1
volume = 255
IntPersistIndex = 30
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 20
ground.front = 18
air.back = 12
air.front = 20
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -70
mid.pos = -5, -50
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 3.0
walk.back = -2.0
jump.neu = 0,-9.2
jump.back = -3.5
jump.fwd = 3.0

[Movement]
airjump.num = 0
airjump.height = 28
yaccel = .4
stand.friction = .85
crouch.friction = .82

;===========================================================================
; Run
;===========================================================================
[Statedef 100]
type    = S
physics = N
ctrl = 0
anim = 100
sprpriority = 1

[State 100, 1]
type = PlaySND
trigger1 = Time = 0
value = F100,0

[State 105, 1]
type = StateTypeSet
trigger1 = AnimElem = 4
StateType = A

[STate 1]
type = Velset
trigger1 = Time = 3
x = 10
y = -3

[state a]
type = veladd
trigger1 = animelem = 2,>0
y = 0.9

[state a]
type = velmul
trigger1 = 1
x = 0.95

[State 105, 3]
type = ChangeState
trigger1 = Pos Y >= 0 && Vel Y > 0
value = 101

[Statedef 101]
type    = S
physics = S
ctrl = 0
anim = 101
velset = 0,0

[State 100, 1]
type = PlaySND
trigger1 = Time = 0
value = F52,0

[State 106, 1]
type = PosSet
trigger1 = Time = 0
y = 0

[State 106, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

