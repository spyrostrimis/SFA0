trigger1 = Matchover && time > 1
flag = NoMusic


[State 181, 16]; Remove elements
type = AssertSpecial
trigger1 = MatchOver = 1 && time >= 0
flag = nobardisplay
flag2 = noFG
flag3 = invisible

