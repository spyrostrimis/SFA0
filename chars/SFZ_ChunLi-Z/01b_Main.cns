walk.back = -3.06
run.fwd	= 5.8,0
run.back = -3.8,0
jump.neu = 0,-8.7
jump.fwd = 4.28
jump.back = -4.28
runjump.back = -4.5,-9.5
runjump.fwd = 4.5,-9.5
airjump.neu = 0,-9.5
airjump.back = -4.28,-9.0
airjump.fwd = 4.28,-9.0

[Movement]
