yscale = 1
ground.back = 22
ground.front = 22
air.back = 17
air.front = 17
z.width = 0;10
height = 60
attack.width = 4,4
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = 5,-74
mid.pos = -8,-52
shadowoffset = 1
draw.offset= 0,3

[Velocity]
