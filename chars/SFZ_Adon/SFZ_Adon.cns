anim = F180
pos = 0,-5
sound = F180,180
postype = Left
facing = 1
sprpriority = 9
ownpal = 0

[State 181, Perfect Voice]
type = PlaySnd
triggerall = WinPerfect
trigger1 = (IsHomeTeam = 0) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
trigger1 = time = 0
value = F180,180
Loop = 0

[State 181, Win Voice]
type = PlaySnd
triggerall = WinKO = 1
trigger1 = (IsHomeTeam = 0) && (GameMode != "versus") && (GameMode != "watch") && TeamLeader = PlayerNo
value = F3,1
Loop = 0

[State 181, Lose Voice]
