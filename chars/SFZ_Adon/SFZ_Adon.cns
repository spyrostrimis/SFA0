;===========================================================================
; Main data
;===========================================================================
[Data]
life = 1000
power = 3000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 43
airjuggle = 15
sparkno = ifelse(teamside = 1,7,50007)
guard.sparkno = ifelse(teamside = 1,1,50001)
KO.echo = 1
volume = 255
IntPersistIndex = 30
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 24
ground.front = 26
air.back = 20
air.front = 21
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -82
mid.pos = -5, -60
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 3.0
walk.back = -2.0
run.fwd  = 4.6, 0
run.back = -4.5,0
jump.neu = 0,-8.0
jump.back = -3.0
jump.fwd = 4.0
runjump.back = -2.55,-7.1
runjump.fwd = 4,-7.1
airjump.neu = 0,-8.1
airjump.back = -2.55
airjump.fwd = 2.5

[Movement]
airjump.num = 0
airjump.height = 28
yaccel = .44
stand.friction = .85
crouch.friction = .82

;===========================================================================
; Run
;===========================================================================
; Forward
[Statedef 100]
ttype    = S
physics = N
ctrl = 0
anim = 105
sprpriority = 1

[state 181, 1]
type = playsnd
trigger1 = Time = 0
value = F100,0

[State 100, 1]
type = StateTypeSet
trigger1 = AnimElem = 3
StateType = A

[STate 1]
type = Velset
trigger1 = Time = 2
x = 8
y = -3

[state a]
type = veladd
trigger1 = animelem = 3,>0
y = 0.9

[state a]
type = velmul
trigger1 = 1
x = 0.95

[State 100, 3]
type = ChangeState
trigger1 = Pos Y >= 0 && Vel Y > 0
value = 106

