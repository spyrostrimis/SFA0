;===========================================================================
; Archive Cody Travers            
;===========================================================================
; Main Data
;===========================================================================
[Data]
life = 1000
power = 3000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 43
airjuggle = 15
sparkno = ifelse(teamside = 1,7,50007)
guard.sparkno = ifelse(teamside = 1,1,50001)
KO.echo = 1
volume = 255
IntPersistIndex = 30
FloatPersistIndex = 40

[Size]
xScale = 1
yScale = 1
ground.back = 15
ground.front = 15
air.back = 15
air.front = 15
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doScale = 0
head.pos = 10, -92
mid.pos = 0, -57
shadowOffset = 0
draw.offset = 0,2

[Velocity]
walk.fwd  = 2.8
walk.back = -2.1
run.fwd  = 5.2,0
run.back = -7,-3
jump.neu = 0, -8.2
jump.fwd = 2.9
jump.back = -3.3
runJump.fwd = 4.3, -10
runJump.back = -4.55, -10
airjump.neu = 0,-6.5
airjump.back = -2.55
airjump.fwd = 2.5

[Movement]
airJump.num = 0
airJump.height = 0
yAccel = 0.46875
stand.friction = 0.85
crouch.friction = 0.82
stand.friction.threshold = 1.0
crouch.friction.threshold = 1.0
air.gethit.groundLevel = 25
air.gethit.groundRecover.ground.threshold = -20
air.gethit.groundRecover.groundLevel = 10
air.gethit.airRecover.threshold = -1
air.gethit.airRecover.yAccel = 0.35
air.gethit.trip.groundLevel = 15
down.bounce.offset = 0, 20
down.bounce.yAccel = 0.4
down.bounce.groundLevel = 12
down.friction.threshold = 0.5

;===========================================================================
; States principales
;===========================================================================
; En pie
[StateDef 0]
type = S
physics = S
moveType = I
velSet = 0,0
sprPriority = 0

[State -7, 5] ;Are you floating?
type = ChangeState
triggerall = pos y < 0
trigger1 = time > 1
value = 52

[State -2, PlayDialogueMusic]
type = PlaySnd
trigger1 = MotifState(dialogue) && !MotifState(demo)
value = F7777,0
channel = 25
persistent = 0

[State -2, StopDialogueMusic]
type = StopSnd
trigger1 = RoundState = 2
channel = 25
persistent = 0

[State -2, 3] ;Hyper
type = PowerAdd
triggerall = TeamSide = 1
triggerall = gamemode = "worldtour"
triggerall = matchno = 16 || matchno = 21
trigger1 = power < 3000
value = 3000

[State 0, PlaySound]
type = PlaySnd
trigger1 = GameMode = "timeattack"
trigger1 = Player(1), ConsecutiveWins = 9
trigger1 = (stateno = 0 && roundstate = 1 && p2stateno = 0) && Time = 1
value = F0,10
channel = 0
ctrl = 0
ignorehitpause = 1

[State 181, 8] ; Final Round
type = Explod
trigger1 = GameMode = "timeattack"
trigger1 = Player(1), ConsecutiveWins = 9
trigger1 = (stateno = 0 && roundstate = 1 && p2stateno = 0) && Time = 1
anim = F910
ID = 910
pos = 100,35
postype = left
sprpriority = 8
removetime = 70
ctrl = 0
persistent = 0
ignorehitpause = 1

[State 0, Remove Explods]
type = RemoveExplod
trigger1 = IsHelper

[State 0, Destroy Helpers]
type = DestroySelf
trigger1 = IsHelper

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = (var(40) != 1 && anim != 0 + Var(29)*10000) || (var(40) = 1 && anim != 2 + Var(29)*10000)
trigger1 = anim != 5 + Var(29)*10000
trigger2 = anim = 5 + Var(29)*10000 && !animtime
value = ifelse(var(40) = 1, 2, 0) + Var(29)*10000

[State 0, Dead]
type = ChangeState
trigger1 = !Alive
value = 5050

; Agacharse
[StateDef 10]
type = C
physics = C
moveType = I
velSet = 0,0
sprPriority = 0

[State -7, 5] ;Are you floating?
type = ChangeState
triggerall = pos y < 0
trigger1 = time > 1
value = 52

[State 10, ChangeAnim]
type = ChangeAnim
trigger1 = !Time && Anim = 12 + Var(29)*10000
value = 10 + Var(29)*10000
elem = 3 - AnimElemNo(0)

[State 10, ChangeAnim]
type = ChangeAnim
trigger1 = Anim != 10 + Var(29)*10000
value = 10 + Var(29)*10000

[State 10, End]
type = ChangeState
trigger1 = !AnimTime
value = 11

; agachado
[StateDef 11]
type = C
physics = C
moveType = I
anim = 11 + Var(29)*10000
velSet = 0,0
sprPriority = 0

[State 11, ChangeAnim]
type = ChangeAnim
trigger1 = Anim = 6 + Var(29)*10000 && !AnimTime
value = 11 + Var(29)*10000

; Parandose
[StateDef 12]
type = S
physics = S
moveType = I
velSet = 0,0
sprPriority = 0

[State 12, ChangeAnim]
type = ChangeAnim
trigger1 = !Time && Anim = 10 + Var(29)*10000
value = 12 + Var(29)*10000
elem = 3 - AnimElemNo(0)

[State 12, ChangeAnim]
type = ChangeAnim
trigger1 = Anim != 12 + Var(29)*10000
value = 12 + Var(29)*10000

[State 12, End]
type = ChangeState
trigger1 = command = "holddown" && command != "holdup"
value = 10

[State 12, End]
type = ChangeState
trigger1 = !AnimTime
value = 0

; Avanzar / retroceder
[StateDef 20]
type = S
physics = S
moveType = I
sprPriority = 0

[State 20, VelSet]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, VelSet]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, ChangeAnim]
type = ChangeAnim
triggerAll = vel x > 0
trigger1 = Anim != 20 + Var(29)*10000 && Anim != 5 + Var(29)*10000
trigger2 = Anim = 5 + Var(29)*10000 && AnimElemTime(1) >= 1
value = 20 + Var(29)*10000

[State 20, ChangeAnim]
type = ChangeAnim
triggerAll = vel x < 0
trigger1 = Anim != 21 + Var(29)*10000 && Anim != 5 + Var(29)*10000
trigger2 = Anim = 5 + Var(29)*10000 && AnimElemTime(1) >= 1
value = 21 + Var(29)*10000

;===========================================================================
; Sistema de saltos
;===========================================================================
[Statedef 40]
type    = S
physics = S
anim = 40 + Var(29)*10000
ctrl = 0
sprpriority = 1
facep2 = 1

[State -7, 5] ;Are you floating?
type = ChangeState
triggerall = pos y < 0
trigger1 = time > 1
value = 52

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 45, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(44)
value = 44 + Var(29)*10000

[State 45, 2]
type = ChangeAnim
trigger1 = !SelfAnimExist(44)
value = 41 + Var(29)*10000

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, 6]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, 7]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > Const720p(-8)
trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 41 && anim <= 43
persistent = 0
value = Anim + 3

;---------------------------------------------------------------------------
; Jump Down (empty state for compatibility)
[Statedef 51]
type    = A
physics = A

[State 51, 1]
type = Null
trigger1 = 1

;---------------------------------------------------------------------------
; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47 + Var(29)*10000

[State 5100, 10]
type = PlaySnd
trigger1 = Time = 1
value = F52,0

[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 52, 4]
type = VelSet
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
x = 0

[State 52, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;===========================================================================
; Run
;===========================================================================
; Forward
[StateDef 100]
type = A
physics = N
moveType = I
anim = 100 + Var(29)*10000
ctrl = 0
sprPriority = 1

[State 110, Dash Sound]
type = PlaySnd
trigger1 = !Time
value = F100,0

[State 110, VelSet]
type = VelSet
trigger1 = AnimElem = 2
x = 7.8
y = -3

[State 110, VelMul]
type = VelMul
trigger1 = AnimElemTime(3) > 0
x = 0.98

[State 110, VelAdd]
type = VelAdd
trigger1 = AnimElemTime(3) > 0
y = 0.65

[State 110, End]
type = ChangeState
trigger1 = AnimElemTime(3) >= 0
trigger1 = pos y > -vel y
value = 101

;Stop Dashing Forward
[StateDef 101]
type = S
physics = S
ctrl = 1
anim = 101 + Var(29)*10000
velSet = 0,0

[State 111, PosSet]
type = PosSet
trigger1 = 1
y = 0

[State 111, Dash End Sound]
type = PlaySnd
trigger1 = !Time
value = F52,0

[State 111, End]
type = ChangeState
trigger1 = !AnimTime
value = 0
ctrl = 1

; Back
[StateDef 105]
type = A
physics = N
moveType = I
velSet = 0,0
anim = 105 + Var(29)*10000
ctrl = 0
sprPriority = 1

[State 105, Back Dash Sound]
type = PlaySnd
trigger1 = AnimElem = 2
value = F100,0

[State 105, VelSet]
type = VelSet
trigger1 = AnimElem = 2
x = const(velocity.run.back.x)
y = const(velocity.run.back.y)

[State 105, VelMul]
type = VelMul
trigger1 = AnimElemTime(3) > 0
x = 0.98

[State 105, VelAdd]
type = VelAdd
trigger1 = AnimElemTime(3) > 0
y = 0.65

[State 105, End]
type = ChangeState
trigger1 = AnimElemTime(3) >= 0
trigger1 = pos y > -vel y
value = 106

;Stop Dashing Backwards
[StateDef 106]
type = S
physics = S
ctrl = 0
anim = 106 + Var(29)*10000
velSet = 0,0

[State 106, PosSet]
type = PosSet
trigger1 = 1
y = 0

[State 106, Landing Sound]
type = PlaySnd
trigger1 = !Time
value = F52,0

[State 106, CtrlSet]
type = CtrlSet
trigger1 = Time >= 2
value = 1

[State 106, End]
type = ChangeState
trigger1 = !AnimTime
value = 0
ctrl = 1

;===========================================================================
; Defensa
;===========================================================================
; GUARD (start)
[Statedef 120]
type = U
physics = U

[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
value = (120+(statetype=C)+(statetype = A)*2)+Var(29)*10000

[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 120, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 130+(statetype=C)+(statetype = A)*2

[State 120, Stop Guarding]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = !inguarddist
value = 140

;---------------------------------------------------------------------------
; Stand guard (guarding)
[Statedef 130]
type    = S
physics = S

[State 130, 1]
type = ChangeAnim
trigger1 = Anim != 130
value = 130+Var(29)*10000

[State 130, Hi to Lo]
type = ChangeState
trigger1 = command = "holddown"
value = 131

[State 130, Stop Guarding]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = !inguarddist
value = 140

;---------------------------------------------------------------------------
